<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- ═══ Enjaz Light Theme Color Palette ═══ -->
    <Color x:Key="PrimaryColor">#0B193C</Color> <!-- Navy Blue -->
    <Color x:Key="PrimaryLightColor">#222E52</Color> 
    <Color x:Key="SecondaryColor">#059669</Color> <!-- Emerald Green -->
    <Color x:Key="SecondaryLightColor">#D1FAE5</Color>

    <!-- Backgrounds -->
    <Color x:Key="WindowBackgroundColor">#F4F7F9</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SidebarColor">#0B193C</Color>
    <Color x:Key="SidebarHoverColor">#1a2f5c</Color>
    
    <!-- Text -->
    <Color x:Key="PrimaryTextColor">#0B193C</Color>
    <Color x:Key="SecondaryTextColor">#454652</Color>
    <Color x:Key="SidebarTextColor">#FFFFFF</Color>
    <Color x:Key="SidebarMutedColor">#CBD5E1</Color>
    
    <!-- UI Elements -->
    <Color x:Key="BorderColor">#E2E8F0</Color>
    <Color x:Key="DividerColor">#E2E8F0</Color>
    <Color x:Key="InputBackgroundColor">#FFFFFF</Color>
    <Color x:Key="InputBorderColor">#E2E8F0</Color>
    <Color x:Key="SelectionColor">#EFF6FF</Color>

    <!-- Actions -->
    <Color x:Key="SuccessColor">#059669</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="DangerColor">#ba1a1a</Color>

    <!-- ═══ Brushes ═══ -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryActionBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHoverColor}"/>
    
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="{StaticResource SidebarTextColor}"/>
    <SolidColorBrush x:Key="SidebarMutedBrush" Color="{StaticResource SidebarMutedColor}"/>
    
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>
    
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}"/>
    <SolidColorBrush x:Key="InputFocusBrush" Color="{StaticResource SecondaryColor}"/>
    
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}"/>
    
    <!-- Button Brushes -->
    <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#3B82F6"/> <!-- Blue -->
    <SolidColorBrush x:Key="TertiaryButtonBrush" Color="#F59E0B"/> <!-- Amber -->
    
    <!-- MaterialDesign Button Overrides - ensures white text on dark primary buttons -->
    <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryHueMidForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryHueLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryHueLightForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryHueDarkBrush" Color="#050D1F"/>
    <SolidColorBrush x:Key="PrimaryHueDarkForegroundBrush" Color="#FFFFFF"/>
    
    <!-- Sidebar Selected -->
    <SolidColorBrush x:Key="SidebarSelectedBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarSelectedForegroundBrush" Color="{StaticResource PrimaryColor}"/>

    <!-- DataGrid -->
    <SolidColorBrush x:Key="DataGridHeaderBrush" Color="#F8FAFC"/>
    <!-- Glassmorphism Brushes -->
    <SolidColorBrush x:Key="GlassBackgroundBrush" Color="#CCFFFFFF"/>
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#1A000000"/>
    <SolidColorBrush x:Key="GlassInputBackgroundBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="GlassTextBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="GlassMutedTextBrush" Color="#64748B"/>

</ResourceDictionary>
