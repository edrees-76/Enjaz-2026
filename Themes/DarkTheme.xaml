<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- ═══ Enjaz 2026 — Liquid/Adaptive Glass Dark Theme               ═══ -->
    <!-- ═══ Version 2.0 — Deep Ocean + Emerald Glow                     ═══ -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <!-- ─── Core Identity Colors ─── -->
    <Color x:Key="PrimaryColor">#10B981</Color>         <!-- Emerald 500 — vibrant primary -->
    <Color x:Key="PrimaryLightColor">#34D399</Color>    <!-- Emerald 400 — hover/light -->
    <Color x:Key="PrimaryDarkColor">#059669</Color>     <!-- Emerald 600 — pressed -->
    <Color x:Key="SecondaryColor">#3B82F6</Color>       <!-- Blue 500 — accent -->
    <Color x:Key="AccentColor">#06B6D4</Color>          <!-- Cyan 500 — highlights -->

    <!-- ─── Liquid Glass Backgrounds ─── -->
    <Color x:Key="WindowBackgroundColor">#080E1E</Color>      <!-- Deep midnight -->
    <Color x:Key="SurfaceColor">#111827</Color>               <!-- Gray 900 — card surfaces -->
    <Color x:Key="SurfaceElevatedColor">#1F2937</Color>       <!-- Gray 800 — elevated cards -->
    <Color x:Key="SidebarColor">#060B18</Color>               <!-- Ultra-deep sidebar -->
    <Color x:Key="SidebarHoverColor">#1F2937</Color>          <!-- Hover state -->
    
    <!-- ─── Adaptive Text ─── -->
    <Color x:Key="PrimaryTextColor">#F1F5F9</Color>    <!-- Slate 100 — high contrast -->
    <Color x:Key="SecondaryTextColor">#94A3B8</Color>   <!-- Slate 400 — muted -->
    <Color x:Key="TertiaryTextColor">#64748B</Color>    <!-- Slate 500 — subtle -->
    <Color x:Key="SidebarTextColor">#E2E8F0</Color>     <!-- Slate 200 -->
    <Color x:Key="SidebarMutedColor">#64748B</Color>    <!-- Slate 500 -->
    
    <!-- ─── UI Fabric ─── -->
    <Color x:Key="BorderColor">#1E293B</Color>          <!-- Slate 800 — subtle borders -->
    <Color x:Key="DividerColor">#1E293B</Color>
    <Color x:Key="InputBackgroundColor">#0F172A</Color>  <!-- Slate 900 — input wells -->
    <Color x:Key="InputBorderColor">#334155</Color>      <!-- Slate 700 -->
    <Color x:Key="SelectionColor">#1E3A5F</Color>        <!-- Dark blue selection -->
    <Color x:Key="HoverOverlayColor">#1AFFFFFF</Color>   <!-- 10% white overlay -->

    <!-- ─── Semantic Actions ─── -->
    <Color x:Key="SuccessColor">#10B981</Color>    <!-- Emerald 500 -->
    <Color x:Key="WarningColor">#F59E0B</Color>    <!-- Amber 500 -->
    <Color x:Key="DangerColor">#EF4444</Color>     <!-- Red 500 -->
    <Color x:Key="InfoColor">#3B82F6</Color>       <!-- Blue 500 -->

    <!-- ═══════════════════════════════════════ -->
    <!-- ═══ Solid Brushes                   ═══ -->
    <!-- ═══════════════════════════════════════ -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryActionBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHoverColor}"/>
    
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="{StaticResource TertiaryTextColor}"/>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="{StaticResource SidebarTextColor}"/>
    <SolidColorBrush x:Key="SidebarMutedBrush" Color="{StaticResource SidebarMutedColor}"/>
    
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>
    
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}"/>
    <SolidColorBrush x:Key="InputFocusBrush" Color="{StaticResource PrimaryColor}"/>
    
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}"/>
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="{StaticResource HoverOverlayColor}"/>
    
    <!-- ─── Button Brushes ─── -->
    <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="TertiaryButtonBrush" Color="#F59E0B"/>
    
    <!-- ─── Sidebar Selected ─── -->
    <SolidColorBrush x:Key="SidebarSelectedBackgroundBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="SidebarSelectedForegroundBrush" Color="#FFFFFF"/>

    <!-- ─── DataGrid ─── -->
    <SolidColorBrush x:Key="DataGridHeaderBrush" Color="#0F172A"/>

    <!-- ═══════════════════════════════════════ -->
    <!-- ═══ Liquid Glass System (Dark)      ═══ -->
    <!-- ═══════════════════════════════════════ -->
    
    <!-- Glass Surfaces — semi-transparent backgrounds with frosted feel -->
    <SolidColorBrush x:Key="GlassBackgroundBrush" Color="#1AFFFFFF"/>       <!-- 10% white -->
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#22FFFFFF"/>           <!-- 13% white border -->
    <SolidColorBrush x:Key="GlassInputBackgroundBrush" Color="#0DFFFFFF"/>  <!-- 5% white for inputs -->
    <SolidColorBrush x:Key="GlassTextBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="GlassMutedTextBrush" Color="#94A3B8"/>
    
    <!-- Glass Elevated — for cards, popups, dropdowns -->
    <SolidColorBrush x:Key="GlassElevatedBrush" Color="#26FFFFFF"/>         <!-- 15% white -->
    <SolidColorBrush x:Key="GlassHighlightBrush" Color="#33FFFFFF"/>        <!-- 20% white — active state -->
    
    <!-- Gradient Brushes — Liquid flow effect -->
    <LinearGradientBrush x:Key="LiquidGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#10B981" Offset="0"/>
        <GradientStop Color="#06B6D4" Offset="0.5"/>
        <GradientStop Color="#3B82F6" Offset="1"/>
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="LiquidGradientSubtleBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1A10B981" Offset="0"/>
        <GradientStop Color="#1A06B6D4" Offset="0.5"/>
        <GradientStop Color="#1A3B82F6" Offset="1"/>
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#060B18" Offset="0"/>
        <GradientStop Color="#0B1120" Offset="0.5"/>
        <GradientStop Color="#0A1628" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeaderGlowBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0010B981" Offset="0"/>
        <GradientStop Color="#3310B981" Offset="0.5"/>
        <GradientStop Color="#0010B981" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
