<UserControl x:Class="Enjaz.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:models="clr-namespace:Enjaz.Models"
             xmlns:converters="clr-namespace:Enjaz.Converters"
             xmlns:controls="clr-namespace:Enjaz.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:StringContainsConverter x:Key="StringContainsConverter"/>
        <!-- Converter for Inverse Boolean -->
        <Style x:Key="InverseBoolToVis" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPermissionsSectionVisible}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ToolTip style for chips -->
        <Style TargetType="ToolTip" BasedOn="{StaticResource MaterialDesignToolTip}">
            <Setter Property="Background" Value="{DynamicResource MaterialDesignDarkBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignDarkForeground}"/>
        </Style>
    </UserControl.Resources>

    <materialDesign:DialogHost IsOpen="{Binding IsUserDialogOpen}" CloseOnClickAway="False">
        <!-- Dialog Content: Add/Edit User -->
        <materialDesign:DialogHost.DialogContent>
            <Border Width="600" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="24" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock FontWeight="Bold" Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignHeadline5TextBlock}">
                                <Setter Property="Text" Value="ادخال بيانات مستخدم جديد"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditingUser}" Value="True">
                                        <Setter Property="Text" Value="تعديل المستخدم"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="450">
                        <StackPanel Margin="4">
                            <!-- Section 1: User Identity Info -->
                            <TextBlock Text="بيانات الحساب" Style="{DynamicResource MaterialDesignSubtitle2TextBlock}" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,12"/>
                            
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBox Grid.Column="0" 
                                         materialDesign:HintAssist.Hint="الاسم الكامل" 
                                         Text="{Binding UserFullName, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{DynamicResource MaterialDesignOutlinedTextBox}"/>
                                
                                <TextBox Grid.Column="2" 
                                         materialDesign:HintAssist.Hint="اسم المستخدم (للتسجيل الدخول)" 
                                         Text="{Binding UserUsername, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{DynamicResource MaterialDesignOutlinedTextBox}"/>
                            </Grid>

                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0" 
                                          materialDesign:HintAssist.Hint="دور المستخدم (Role)"
                                          ItemsSource="{Binding AvailableRoles}"
                                          SelectedItem="{Binding SelectedUserRole}"
                                          Style="{DynamicResource MaterialDesignOutlinedComboBox}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={x:Null}}"/>  
                                            <!-- Assuming enum ToString handles it or just simple binding -->
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <PasswordBox Grid.Column="2" 
                                             materialDesign:HintAssist.Hint="كلمة المرور" 
                                             materialDesign:PasswordBoxAssist.Password="{Binding UserPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{DynamicResource MaterialDesignOutlinedPasswordBox}"/>
                            </Grid>

                            <Separator Margin="0,0,0,16"/>

                            <!-- Section 2: Permissions -->
                            <StackPanel Visibility="{Binding IsPermissionsSectionVisible, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="تخصيص الصلاحيات" Style="{DynamicResource MaterialDesignSubtitle2TextBlock}" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,12"/>
                                <TextBlock Text="ملاحظة: تفعيل خيارات التبديل أدناه يمنح المستخدم صلاحية الدخول للأقسام المحددة." 
                                           Style="{DynamicResource MaterialDesignCaptionTextBlock}" Opacity="0.7" Margin="0,0,0,16"/>
                                
                                <WrapPanel Margin="-8" Orientation="Horizontal">
                                    <StackPanel Orientation="Horizontal" Margin="8,8,24,8" ToolTip="الدخول لتسجيل عينات جديدة وإدارتها">
                                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding CanAccessSampleReceptions}"/>
                                        <TextBlock Text="استقبال العينات" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="8,8,24,8" ToolTip="تصدير وعرض شهادات الفحص">
                                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding CanAccessCertificates}"/>
                                        <TextBlock Text="إصدار الشهادات" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="8,8,24,8" ToolTip="الاطلاع على تقارير المنظومة">
                                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding CanAccessReports}"/>
                                        <TextBlock Text="التقارير والإحصائيات" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="8,8,24,8" ToolTip="الوصول لإعدادات البرنامج الأساسية">
                                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding CanAccessSettings}"/>
                                        <TextBlock Text="إعدادات النظام" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="8,8,24,8" ToolTip="الوصول لإدارة العقود والفواتير">
                                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding CanAccessAdminProcedures}"/>
                                        <TextBlock Text="الإجراءات الإدارية" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="8,8,24,8" ToolTip="إدارة وحذف مستخدمين آخرين">
                                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding CanAccessUsers}"/>
                                        <TextBlock Text="إدارة المستخدمين" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </WrapPanel>
                                
                                <Separator Margin="0,16,0,16"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8" ToolTip="يسمح للمستخدم بتعديل البيانات داخل الأقسام، وبدونه ستكون صلاحياته للقراءة فقط">
                                    <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding IsUserEditor}"/>
                                    <TextBlock Text="صلاحية التعديل للمستخدم (Editor)" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="المدير يمتلك جميع الصلاحيات بشكل افتراضي." 
                                       Style="{StaticResource InverseBoolToVis}"
                                       Foreground="{DynamicResource MaterialDesignSecondaryText}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,24,0,0">
                        <Button Command="{Binding SaveUserCommand}" Cursor="Hand" Margin="0,0,12,0" Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderThickness="0">
                            <TextBlock Text="حفظ البيانات" Foreground="White" FontWeight="SemiBold" FontSize="14" />
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="16,6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Command="{Binding CancelUserEditCommand}" Cursor="Hand">
                            <TextBlock Text="إلغاء" FontWeight="SemiBold" FontSize="14" />
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" CornerRadius="5" Padding="16,6" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </materialDesign:DialogHost.DialogContent>

        <!-- Main Dashboard Layout -->
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="إدارة المستخدمين" Style="{DynamicResource MaterialDesignHeadline4TextBlock}" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="تحكم في حسابات النظام وصلاحياتها بكل سهولة" Style="{DynamicResource MaterialDesignSubtitle1TextBlock}" Opacity="0.7" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>

                <!-- Stats Summary -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0">
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,12,0" MinWidth="100">
                        <StackPanel>
                            <TextBlock Text="إجمالي المستخدمين" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding TotalUsersCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,12,0" MinWidth="100">
                        <StackPanel>
                            <TextBlock Text="نشط" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding ActiveUsersCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" MinWidth="100">
                        <StackPanel>
                            <TextBlock Text="إداري (Admin)" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding AdminUsersCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBox Grid.Column="2" 
                         Margin="16,0" Width="250" VerticalAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource MaterialDesignOutlinedTextBox}" 
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         materialDesign:HintAssist.Hint="بحث بالاسم..."
                         materialDesign:TextFieldAssist.HasClearButton="True"
                         materialDesign:TextFieldAssist.LeadingIcon="Search"/>

                <Button Grid.Column="3" 
                        Command="{Binding AddUserCommand}" 
                        Style="{StaticResource PrimaryButtonStyle}" 
                        Height="42" Padding="20,0" VerticalAlignment="Center" Foreground="White">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountPlus" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="White"/>
                        <TextBlock Text="مستخدم جديد" FontFamily="Inter" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Tabs Section -->
            <TabControl Grid.Row="1" Background="Transparent">
                <TabControl.Resources>
                    <Style TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="Margin" Value="0,0,24,0"/>
                        <Setter Property="Padding" Value="16,12"/>
                    </Style>
                </TabControl.Resources>

                <!-- Users Tab -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountMultiple" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="قائمة الحسابات" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="0,16,0,0">
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                            <!-- Card-styled DataGrid -->
                            <DataGrid ItemsSource="{Binding Users}" AutoGenerateColumns="False" CanUserAddRows="False" 
                                      IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                                      SelectedItem="{Binding SelectedUser}"
                                      BorderThickness="0" Background="Transparent"
                                      GridLinesVisibility="None" RowHeight="55" MinRowHeight="55">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="15,12"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Padding" Value="15,5"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.CellStyle>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#0A000000"/> 
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="المستخدم">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="8,0">
                                                    <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource PrimaryActionBrush}" Margin="0,0,12,0" Opacity="0.8">
                                                        <materialDesign:PackIcon Kind="Account" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Width="20" Height="20"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}"/>
                                                        <TextBlock Text="{Binding Username}" FontSize="12" Opacity="0.7" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="الدور">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Padding="12,4" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Role}" Value="Admin">
                                                                    <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                                                    <Setter Property="BorderThickness" Value="0"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Role}" FontSize="12" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Role}" Value="Admin">
                                                                        <Setter Property="Foreground" Value="White"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                                        <Setter Property="Foreground" Value="White"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="الحالة">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Padding="12,4" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <!-- Frozen: Red shade -->
                                                            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/> 
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/> <!-- Green for active -->
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Width="14" Height="14" VerticalAlignment="Center" Margin="-4,0,4,0" Foreground="White">
                                                            <materialDesign:PackIcon.Style>
                                                                <Style TargetType="materialDesign:PackIcon">
                                                                    <Setter Property="Kind" Value="CancelCircle"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                            <Setter Property="Kind" Value="CheckCircle"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </materialDesign:PackIcon.Style>
                                                        </materialDesign:PackIcon>
                                                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="مجمد"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                            <Setter Property="Text" Value="نشط"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="الإجراءات" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <Button Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                            CommandParameter="{Binding}"
                                                            Style="{DynamicResource MaterialDesignIconForegroundButton}"
                                                            ToolTip="تعديل المستخدم" Width="40" Height="40" Padding="0">
                                                        <materialDesign:PackIcon Kind="Pencil" Width="20" Height="20">
                                                            <materialDesign:PackIcon.Style>
                                                                <Style TargetType="materialDesign:PackIcon">
                                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryActionBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                                            <Setter Property="Foreground" Value="White"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </materialDesign:PackIcon.Style>
                                                        </materialDesign:PackIcon>
                                                    </Button>
                                                    <Button Command="{Binding DataContext.ToggleUserFreezeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                            CommandParameter="{Binding}"
                                                            Style="{DynamicResource MaterialDesignIconForegroundButton}"
                                                            Width="40" Height="40" Padding="0">
                                                        <Button.ToolTip>
                                                            <TextBlock>
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="تنشيط الحساب"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                <Setter Property="Text" Value="تجميد الحساب"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Button.ToolTip>
                                                        <materialDesign:PackIcon Width="20" Height="20">
                                                            <materialDesign:PackIcon.Style>
                                                                <Style TargetType="materialDesign:PackIcon">
                                                                    <Setter Property="Kind" Value="PlayCircle"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                            <Setter Property="Kind" Value="PauseCircle"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                                            <Setter Property="Foreground" Value="White"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </materialDesign:PackIcon.Style>
                                                        </materialDesign:PackIcon>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Activity Log Tab -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="History" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="سجل النشاطات" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Timeline -->
                        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,16,0" Padding="16">
                            <ListView ItemsSource="{Binding UserActivities}" BorderThickness="0" Background="Transparent" 
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#0A000000"/> 
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource GlassSurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="16,16" Margin="0,0,0,8" CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/> <!-- Icon -->
                                                    <ColumnDefinition Width="*"/>    <!-- Content -->
                                                </Grid.ColumnDefinitions>

                                                <!-- Icon Column (Far Right in RTL) -->
                                                <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource PrimaryBrush}" Opacity="0.1" Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Top"/>
                                                <materialDesign:PackIcon Kind="History" Width="22" Height="22" Foreground="{DynamicResource PrimaryBrush}" Grid.Column="0" Margin="0,11,16,0" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                                                <!-- Main Content -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                                    <!-- Action Title -->
                                                    <TextBlock Text="{Binding Action}" FontFamily="Manrope" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                                    
                                                    <!-- Detailed Description -->
                                                    <TextBlock Text="{Binding Description}" FontFamily="Inter" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12" LineHeight="22"/>
                                                    
                                                    <!-- Footer row: User Info & Time -->
                                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,0">
                                                        <!-- User Pill -->
                                                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,12,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="AccountCircle" Width="14" Height="14" Foreground="{DynamicResource PrimaryActionBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding UserName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Time Pill -->
                                                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="ClockOutline" Width="14" Height="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:dd/MM/yyyy hh:mm tt}'}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>

                        <!-- Filter Panel -->
                        <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="تصفية النشاطات" Style="{DynamicResource MaterialDesignSubtitle1TextBlock}" FontWeight="Bold" Margin="0,0,0,16" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                
                                <controls:CustomDatePicker Hint="من تاريخ" SelectedDate="{Binding FilterStartDate}" Margin="0,0,0,16" />
                                <controls:CustomDatePicker Hint="إلى تاريخ" SelectedDate="{Binding FilterEndDate}" Margin="0,0,0,16" />
                                
                                <ComboBox materialDesign:HintAssist.Hint="المستخدم" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUserFilter}" DisplayMemberPath="FullName" Style="{StaticResource FormComboBoxStyle}" Margin="0,0,0,24"/>
                                
                                <Button Command="{Binding LoadActivitiesCommand}" 
                                        Style="{StaticResource PrimaryButtonStyle}" Height="42" Padding="20,0"
                                        Foreground="White" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="White"/>
                                        <TextBlock Text="إعادة التحميل" FontFamily="Inter" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="White"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ClearFiltersCommand}" 
                                        Style="{DynamicResource MaterialDesignOutlinedButton}" Height="42" Padding="20,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FilterRemove" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="مسح التصفية" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </materialDesign:DialogHost>
</UserControl>
