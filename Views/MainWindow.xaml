<Window x:Class="Enjaz.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:helpers="clr-namespace:Enjaz.Helpers"
        xmlns:views="clr-namespace:Enjaz.Views"
        xmlns:controls="clr-namespace:Enjaz.Controls"
        xmlns:vm="clr-namespace:Enjaz.ViewModels"
        xmlns:models="clr-namespace:Enjaz.Models"
        Title="منظومة إنجاز لإدارة الشهادات" 
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        MinHeight="600" MinWidth="900"
        Icon="/Assets/enjaz_3d_icon_transparent.png"
        Background="{DynamicResource WindowBackgroundBrush}">
    
    <Window.InputBindings>
        <!-- مفتاح Esc لإغلاق النوافذ المنبثقة وإلغاء التعديلات -->
        <KeyBinding Key="Esc" Command="{Binding EscapeCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Styles.xaml"/>
                <ResourceDictionary Source="/Themes/MainUIResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <Style x:Key="CenterAlignmentStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                        <Setter Property="Foreground" Value="White"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
            
            <Style x:Key="RightAlignmentStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Padding" Value="15,0"/>
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                        <Setter Property="Foreground" Value="White"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>


    <materialDesign:DialogHost IsOpen="{Binding IsSecurityChallengeOpen, Mode=TwoWay}"
                               CloseOnClickAway="False"
                               Identifier="SecurityDialogHost"
                               FlowDirection="RightToLeft">
        <materialDesign:DialogHost.DialogContent>
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="20" Width="450" Padding="30" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="0" Color="Black" Opacity="0.1"/>
                </Border.Effect>
                <StackPanel>
                    <materialDesign:PackIcon Kind="ShieldLock" Width="60" Height="60" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <TextBlock Text="{Binding SecurityChallengeTitle}" FontSize="24" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding SecurityChallengeMessage}" FontSize="15" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,25" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    
                    <!-- Phrase Input -->
                    <StackPanel Visibility="{Binding IsPhraseRequired, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="يرجى كتابة الجملة التالية تماماً للتأكيد:" FontWeight="SemiBold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                        <Border BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="2" CornerRadius="12" Margin="0,0,0,20">
                            <Grid>
                                <Rectangle Fill="{DynamicResource PrimaryBrush}" Opacity="0.15" RadiusX="10" RadiusY="10"/>
                                <TextBlock Text="اريد ذلك بالظبط" Foreground="{DynamicResource PrimaryBrush}" FontWeight="ExtraBold" FontSize="24" HorizontalAlignment="Center" Padding="20,15"/>
                            </Grid>
                        </Border>
                        <TextBox Text="{Binding SecurityChallengePhraseInput, UpdateSourceTrigger=PropertyChanged}" 
                                 materialDesign:HintAssist.Hint="اكتب الجملة هنا..."
                                 Style="{DynamicResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,20"/>
                    </StackPanel>
                    
                    <!-- Password Input -->
                    <StackPanel Visibility="{Binding IsPasswordRequired, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="أدخل كلمة المرور الخاصة بك للمتابعة:" FontWeight="SemiBold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                        <PasswordBox helpers:PasswordBoxHelper.Attach="True" 
                                     helpers:PasswordBoxHelper.Password="{Binding SecurityChallengePasswordInput, Mode=TwoWay}"
                                     materialDesign:HintAssist.Hint="كلمة المرور"
                                     Style="{DynamicResource MaterialDesignOutlinedPasswordBox}" Margin="0,0,0,20"/>
                    </StackPanel>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1" Command="{Binding SubmitSecurityChallengeCommand}" 
                                Style="{StaticResource PrimaryButtonStyle}" Height="45" Margin="5">
                            <TextBlock Text="تأكيد التنفيذ" Foreground="White" FontWeight="Bold" FontSize="15"/>
                        </Button>
                        <Button Grid.Column="0" Command="{Binding CancelSecurityChallengeCommand}" 
                                Style="{StaticResource SecondaryButtonStyle}" Height="45" Margin="5">
                            <TextBlock Text="إلغاء الأمر" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" FontSize="15"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </materialDesign:DialogHost.DialogContent>

    <materialDesign:DialogHost IsOpen="{Binding IsNotificationDialogOpen, Mode=TwoWay}"
                               CloseOnClickAway="True"
                               Identifier="MainDialogHost"
                               FlowDirection="RightToLeft">
        <materialDesign:DialogHost.DialogContent>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource UnifiedNotificationTemplate}"/>
        </materialDesign:DialogHost.DialogContent>

        <Grid FlowDirection="RightToLeft">
        <Grid.ColumnDefinitions>
            <ColumnDefinition>
                <ColumnDefinition.Style>
                    <Style TargetType="ColumnDefinition">
                        <Setter Property="Width" Value="250"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidebarVisible}" Value="False">
                                <Setter Property="Width" Value="0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ColumnDefinition.Style>
            </ColumnDefinition>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- الشريط الجانبي -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarGradientBrush}"
                BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,1,0"
                Visibility="{Binding IsSidebarVisible, Converter={StaticResource BoolToVisConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Logo -->
                    <RowDefinition Height="*"/>     <!-- Navigation (scrollable) -->
                    <RowDefinition Height="Auto"/>  <!-- User profile -->
                </Grid.RowDefinitions>

                <!-- رأس الشريط الجانبي -->
                <StackPanel Grid.Row="0" Margin="25,30,25,20">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Image Source="/Assets/enjaz_3d_icon_transparent.png" Height="55" Margin="0,0,15,0" />
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock Text="منظومة" FontSize="12" FontWeight="Bold" Opacity="0.8"
                                         Foreground="{DynamicResource SuccessBrush}" 
                                         Margin="2,0,0,-4" FontFamily="Manrope"/>
                            </Grid>
                            <TextBlock Text="إنجاز" FontSize="32" FontWeight="Black" 
                                     Foreground="{DynamicResource SuccessBrush}" 
                                     FontFamily="Manrope"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- قائمة التنقل (قابلة للتمرير) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="NavigationPanel" Margin="15,0,15,0">
                    <StackPanel.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Padding" Value="20,8"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource SidebarMutedBrush}"/>
                        </Style>
                    </StackPanel.Resources>
                    
                    <Button Command="{Binding ShowHomeCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ViewDashboard" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="الرئيسية" VerticalAlignment="Center" FontFamily="Manrope" FontSize="13"/>
                        </StackPanel>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.Home}">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Command="{Binding ShowSampleReceptionsCommand}" Visibility="{Binding CurrentUser.HasSampleReceptionsPermission, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Flask" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="استلام العينات" VerticalAlignment="Center" FontFamily="Manrope" FontSize="13"/>
                        </StackPanel>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.SampleReceptions}">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.SampleReceptionForm}">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Command="{Binding ShowCertificatesCommand}" Visibility="{Binding CurrentUser.HasCertificatesPermission, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Certificate" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="الشهادات" VerticalAlignment="Center" FontFamily="Manrope" FontSize="13"/>
                        </StackPanel>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.Certificates}">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Command="{Binding ShowReportsCommand}" Visibility="{Binding CurrentUser.HasReportsPermission, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChartBar" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="التقارير" VerticalAlignment="Center" FontFamily="Manrope" FontSize="13"/>
                        </StackPanel>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.Reports}">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Command="{Binding ShowAdminProceduresCommand}" Visibility="{Binding CurrentUser.HasAdminProceduresPermission, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ShieldAccount" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="الإجراءات الإدارية" VerticalAlignment="Center" FontFamily="Manrope" FontSize="13"/>
                        </StackPanel>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.AdminProcedures}">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Command="{Binding ShowUsersCommand}" Visibility="{Binding CurrentUser.HasUsersPermission, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountMultiple" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="المستخدمين" VerticalAlignment="Center" FontFamily="Manrope" FontSize="13"/>
                        </StackPanel>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.Users}">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.UserForm}">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding ShowSettingsCommand}" Visibility="{Binding CurrentUser.HasSettingsPermission, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Settings" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="الإعدادات" VerticalAlignment="Center" FontFamily="Manrope" FontSize="13"/>
                        </StackPanel>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.Settings}">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Command="{Binding ShowHelpCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="HelpCircle" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="مركز المساعدة" VerticalAlignment="Center" FontFamily="Manrope" FontSize="13"/>
                        </StackPanel>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.Help}">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Command="{Binding ShowAboutCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Information" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="عن المنظومة" VerticalAlignment="Center" FontFamily="Manrope" FontSize="13"/>
                        </StackPanel>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.About}">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!-- Theme Toggle -->
                    <Button Command="{Binding ToggleThemeCommand}" Margin="0,5">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="Brightness7"/>
                                        <Setter Property="Foreground" Value="{DynamicResource SidebarMutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AppIsDarkMode}" Value="False">
                                                <Setter Property="Kind" Value="Brightness4"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                            <TextBlock VerticalAlignment="Center" FontFamily="Manrope" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="وضع فاتح"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AppIsDarkMode}" Value="False">
                                                <Setter Property="Text" Value="وضع داكن"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}"/>
                        </Button.Style>
                    </Button>

                    <!-- User Profile Section -->
                    <Border Margin="10,8,10,10" Padding="10,8" CornerRadius="10" 
                            Background="{DynamicResource HoverOverlayBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource SuccessBrush}" Width="32" Height="32" CornerRadius="16" Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="Account" Foreground="White" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentUser.FullName}" Foreground="{DynamicResource SidebarTextBrush}" FontWeight="SemiBold" FontSize="12" FontFamily="Manrope"/>
                                <TextBlock Text="{Binding CurrentUser.Role}" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="10" FontFamily="Manrope"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
                </ScrollViewer>

                <!-- تسجيل الخروج -->
                <Button Grid.Row="2" 
                        Command="{Binding LogoutCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Margin="15,0,15,10" Padding="15,8"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FEE2E2"/> <!-- Light red background on hover -->
                                                <Setter Property="Foreground" Value="#B91C1C"/> <!-- Darker red text on hover -->
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Logout" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="تسجيل الخروج" VerticalAlignment="Center"
                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                   FontFamily="Manrope" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- المحتوى الرئيسي -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- شريط العنوان -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Padding="20,12"
                    BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="2" Color="#0B193C" Opacity="0.06" Direction="270" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" 
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Command="{Binding ToggleSidebarCommand}"
                            Foreground="{DynamicResource PrimaryBrush}"
                            Margin="0,0,15,0"
                            Padding="5"
                            ToolTip="إظهار/إخفاء القائمة">
                        <materialDesign:PackIcon Kind="Menu" Width="26" Height="26"/>
                    </Button>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="20" FontWeight="Bold" FontFamily="Manrope" Foreground="{DynamicResource PrimaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value=""/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.SampleReceptions}">
                                            <Setter Property="Text" Value="استلام العينات"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.SampleReceptionForm}">
                                            <Setter Property="Text" Value="نموذج استلام عينات"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.Certificates}">
                                            <Setter Property="Text" Value="الشهادات"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CertificatesVM.IsDeletedRecordsView}" Value="True">
                                            <Setter Property="Text" Value="سجل الشهائد المحذوفة"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.CertificateForm}">
                                            <Setter Property="Text" Value="نموذج الشهادة"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.UserForm}">
                                            <Setter Property="Text" Value="نموذج تعديل مستخدم"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.Help}">
                                            <Setter Property="Text" Value="مركز المساعدة"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.Reports}">
                                            <Setter Property="Text" Value="التقارير"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.AdminProcedures}">
                                            <Setter Property="Text" Value="الإجراءات الإدارية"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.Settings}">
                                            <Setter Property="Text" Value="إعدادات النظام"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.About}">
                                            <Setter Property="Text" Value="عن المنظومة"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- القسم الأيسر: المستخدم وتنبيهات النظام -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        
                        <!-- Real-time Clock -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                            <materialDesign:PackIcon Kind="ClockOutline" Foreground="{DynamicResource PrimaryActionBrush}" 
                                                   Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" Opacity="0.8"/>
                            <TextBlock Text="{Binding CurrentDateTime}" 
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"
                                       FontSize="14" 
                                       FontWeight="SemiBold"
                                       FontFamily="Inter"/>
                        </StackPanel>

                        <Grid VerticalAlignment="Center">
                            <!-- زر التنبيهات الموحّد -->
                            <Button x:Name="AlertsButton" Padding="5">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                        <Setter Property="Command" Value="{Binding ToggleAlertsCommand}"/>
                                        <Setter Property="ToolTip" Value="تنبيهات المنظومة - اضغط لعرض التنبيهات"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAlertsEnabled}" Value="False">
                                                <Setter Property="Command" Value="{Binding ToggleAlertsEnabledCommand}"/>
                                                <Setter Property="ToolTip" Value="التنبيهات معطّلة - اضغط للتفعيل"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                
                                <materialDesign:PackIcon Width="26" Height="26">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="BellRingOutline"/>
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryActionBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsAlertsEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                    <Setter Property="Kind" Value="BellOffOutline"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                            </Button>
                            
                            <!-- إشعار رقمي مخصص (Badge) - يظهر فقط عند التفعيل ووجود تنبيهات -->
                            <Border Background="#E74C3C" 
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,2,2,0" Padding="4,0"
                                    MinWidth="18" Height="18" CornerRadius="9"
                                    IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasAlerts}" Value="True"/>
                                                    <Condition Binding="{Binding IsAlertsEnabled}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding AlertCount}" 
                                           FontSize="10" FontWeight="Bold" Foreground="White" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            
                            <Popup IsOpen="{Binding IsAlertsPopupOpen}" 
                                   PlacementTarget="{Binding ElementName=AlertsButton}"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Slide"
                                   Placement="Bottom">
                                <Border Background="{DynamicResource SurfaceBrush}" 
                                        CornerRadius="12" BorderThickness="1" 
                                        BorderBrush="{DynamicResource PrimaryBrush}"
                                        Width="350" MaxHeight="500" Margin="10">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="15" ShadowDepth="5" Opacity="0.2"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        
                                        <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" Padding="15,10" CornerRadius="11,11,0,0">
                                            <TextBlock Text="تنبيهات النظام النشطة" Foreground="White" FontWeight="Bold"/>
                                        </Border>
                                        
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="400">
                                            <ItemsControl ItemsSource="{Binding Alerts}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}" Padding="15,10">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                
                                                                <materialDesign:PackIcon Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Top">
                                                                    <materialDesign:PackIcon.Style>
                                                                        <Style TargetType="materialDesign:PackIcon">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Type}" Value="Error">
                                                                                    <Setter Property="Kind" Value="AlertCircle"/>
                                                                                    <Setter Property="Foreground" Value="Red"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Type}" Value="Warning">
                                                                                    <Setter Property="Kind" Value="Alert"/>
                                                                                    <Setter Property="Foreground" Value="Orange"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Type}" Value="Info">
                                                                                    <Setter Property="Kind" Value="Information"/>
                                                                                    <Setter Property="Foreground" Value="Blue"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </materialDesign:PackIcon.Style>
                                                                </materialDesign:PackIcon>
                                                                
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Margin="0,0,0,2"/>
                                                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                                    <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm yyyy/MM/dd}'}" 
                                                                               FontSize="11" Foreground="{DynamicResource SidebarMutedBrush}" Margin="0,5,0,0"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>

                    <!-- أزرار الإجراءات -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.CertificateForm}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.SampleReceptions}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.SampleReceptionForm}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.Users}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.UserForm}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.Home}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.Help}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.Reports}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.AdminProcedures}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.Settings}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.About}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        
                    </StackPanel>
                </Grid>
            </Border>

            <!-- محتوى الصفحة -->
            <Grid Grid.Row="1" Margin="25">
                <ContentControl Content="{Binding CurrentView}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>
                                <!-- Home -->
                                <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.Home}">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <views:DashboardView DataContext="{Binding DataContext.DashboardVM, RelativeSource={RelativeSource AncestorType=ContentControl}}" />
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                
                                <!-- Certificates -->
                                <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.Certificates}">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <views:CertificatesListView DataContext="{Binding DataContext.CertificatesVM, RelativeSource={RelativeSource AncestorType=ContentControl}}" />
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                
                                <!-- Certificate Form -->
                                <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.CertificateForm}">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <views:CertificateFormView DataContext="{Binding DataContext.CertificatesVM, RelativeSource={RelativeSource AncestorType=ContentControl}}" />
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>

                                <!-- Sample Receptions -->
                                <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.SampleReceptions}">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <views:SampleReceptionsView DataContext="{Binding DataContext.SampleReceptionsVM, RelativeSource={RelativeSource AncestorType=ContentControl}}" />
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>

                                <!-- Sample Reception Form -->
                                <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.SampleReceptionForm}">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <views:SampleReceptionsView DataContext="{Binding DataContext.SampleReceptionsVM, RelativeSource={RelativeSource AncestorType=ContentControl}}" />
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>

                                <!-- Users -->
                                <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.Users}">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <views:UsersView DataContext="{Binding DataContext.UsersVM, RelativeSource={RelativeSource AncestorType=ContentControl}}" />
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                
                                <!-- User Form -->
                                <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.UserForm}">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <views:UsersView DataContext="{Binding DataContext.UsersVM, RelativeSource={RelativeSource AncestorType=ContentControl}}" />
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>

                                <!-- Reports -->
                                <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.Reports}">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <views:ReportsView DataContext="{Binding DataContext.ReportingVM, RelativeSource={RelativeSource AncestorType=ContentControl}}" />
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>

                                <!-- Admin Procedures -->
                                <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.AdminProcedures}">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <views:AdminProceduresView DataContext="{Binding DataContext.AdminProceduresVM, RelativeSource={RelativeSource AncestorType=ContentControl}}"/>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>

                                <!-- Settings -->
                                <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.Settings}">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <views:SettingsView DataContext="{Binding DataContext.SettingsVM, RelativeSource={RelativeSource AncestorType=ContentControl}}" />
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>

                                <!-- Help -->
                                <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.Help}">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <views:HelpView DataContext="{Binding DataContext.HelpVM, RelativeSource={RelativeSource AncestorType=ContentControl}}" />
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>

                                <!-- About -->
                                <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static models:NavigationDestination.About}">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <views:AboutView DataContext="{Binding DataContext.AboutVM, RelativeSource={RelativeSource AncestorType=ContentControl}}" />
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Grid>

            <!-- شريط الحالة -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" Padding="25,12"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
            </Border>
        </Grid>
        <materialDesign:Snackbar MessageQueue="{Binding CertificatesVM.MessageQueue}" Grid.RowSpan="3" VerticalAlignment="Bottom" Margin="0,0,0,60"/>
        
        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="3" Grid.ColumnSpan="2" Background="#DD020617" 
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}, FallbackValue=Collapsed}">
            <Grid.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Black" Offset="0"/>
                    <GradientStop Color="Black" Offset="1"/>
                </LinearGradientBrush>
            </Grid.OpacityMask>
            
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Golden Spinner -->
                <materialDesign:Card UniformCornerRadius="100" Padding="0" Width="80" Height="80"  Background="Transparent">
                     <Viewbox Width="80" Height="80">
                        <Canvas Width="24" Height="24">
                            <Path Data="M12,4V2A10,10 0 0,0 2,12H4A8,8 0 0,1 12,4Z" Fill="#D4A017">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0" CenterX="12" CenterY="12"/>
                                </Path.RenderTransform>
                                <Path.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Path.Triggers>
                            </Path>
                             <Path Data="M12,22A10,10 0 0,0 22,12H20A8,8 0 0,1 12,20V22Z" Fill="#B8860B" Opacity="0.5">
                                 <!-- Second arc for style -->
                                 <Path.RenderTransform>
                                    <RotateTransform Angle="0" CenterX="12" CenterY="12"/>
                                </Path.RenderTransform>
                                 <Path.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1.5"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Path.Triggers>
                             </Path>
                        </Canvas>
                    </Viewbox>
                </materialDesign:Card>
                
                <TextBlock Text="{Binding BusyMessage}" 
                           FontSize="22" FontWeight="SemiBold" 
                           Foreground="#D4A017" 
                           HorizontalAlignment="Center" Margin="0,25,0,0">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="5" ShadowDepth="2" Opacity="0.5"/>
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Grid>
        </materialDesign:DialogHost>
    </materialDesign:DialogHost>
</Window>
