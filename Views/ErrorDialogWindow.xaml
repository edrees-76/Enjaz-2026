<Window x:Class="Enjaz.Views.ErrorDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="خطأ في النظام" Height="Auto" Width="500" 
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="True" 
        SizeToContent="Height" ResizeMode="NoResize"
        FlowDirection="RightToLeft" FontFamily="Inter"
        MouseDown="Window_MouseDown">
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="16" 
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" 
            Margin="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="10" Opacity="0.3" Color="Black" />
        </Border.Effect>
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Background Header Banner -->
            <Border Grid.Row="0" Background="#15F44336" CornerRadius="16,16,0,0" Height="80" VerticalAlignment="Top"/>
            
            <materialDesign:PackIcon Grid.Row="0" Kind="AlertCircleOutline" Width="50" Height="50" 
                                     Foreground="#F44336" HorizontalAlignment="Center" Margin="0,20,0,0"/>

            <!-- Title -->
            <TextBlock Grid.Row="1" x:Name="TitleText" Text="رسالة خطأ" FontSize="20" FontWeight="Bold" 
                       Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="20,15,20,5" TextWrapping="Wrap"/>
            
            <!-- Message -->
            <ScrollViewer Grid.Row="2" MaxHeight="300" Margin="20,10,20,20" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="MessageText" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" 
                           TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
            </ScrollViewer>

            <!-- Buttons Box -->
            <Border Grid.Row="3" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="0,0,16,16" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" Content="نسخ تفاصيل الخطأ" Click="CopyToClipboard_Click" 
                            Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#F44336" BorderBrush="#F44336"/>

                    <Button Grid.Column="1" Content="موافق وإغلاق" Click="CloseButton_Click" 
                            Style="{StaticResource DangerButtonStyle}" 
                            HorizontalAlignment="Right" Width="140" Height="40" FontSize="14"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
