                            <!-- Samples Section -->
                            <TextBlock Text="تفاصيل العينات ونتائج التحليل" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="20,20,0,15"/>

