                                    <DataGridTextColumn Header="التاريخ والوقت" Binding="{Binding TimeFormatted}" Width="160" ElementStyle="{DynamicResource CenterAlignmentStyle}"/>
                                    <DataGridTemplateColumn Header="التفاصيل" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Padding="5" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        
    </Grid>
</UserControl>

