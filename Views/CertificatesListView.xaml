<UserControl x:Class="Enjaz.Views.CertificatesListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Enjaz.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:models="clr-namespace:Enjaz.Models"
             xmlns:helpers="clr-namespace:Enjaz.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <!-- Resources moved to MainUIResources.xaml -->
    </UserControl.Resources>
    
    <Grid>
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsViewingDetails}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelectingType}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Page Header -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding AddCertificateCommand}" 
                            Style="{StaticResource PrimaryButtonStyle}" Height="42" Padding="20,0"
                            Foreground="White">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="White"/>
                            <TextBlock Text="شهادة جديدة" FontFamily="Inter" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox Width="150" 
                              ItemsSource="{Binding SearchCriteriaList}"
                              SelectedItem="{Binding SearchCriteria, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              materialDesign:HintAssist.Hint="معيار البحث"
                              BorderThickness="1"
                              Padding="8,4" Margin="0,0,10,0"/>
                    <TextBox Width="200" 
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="اكتب للبحث..."
                             Margin="0,0,10,0"/>

                    <Button Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="40" Padding="15,0" Margin="0,0,5,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="بحث" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding LoadCertificatesCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="40" Padding="15,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Sync" Width="18" Height="18" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="تعيين" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- جدول الشهادات -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <DataGrid ItemsSource="{Binding Certificates}"
                          SelectedItem="{Binding SelectedCertificate}"
                          AutoGenerateColumns="False"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          MinRowHeight="55" RowHeight="55"
                          EnableRowVirtualization="True"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          Background="Transparent"
                          BorderThickness="0"
                          GridLinesVisibility="None">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Padding" Value="15,12"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#0A000000"/> 
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ت" Binding="{Binding Sequence}" Width="50" ElementStyle="{DynamicResource CenterAlignmentStyle}"/>
                        <DataGridTextColumn Header="رقم الشهادة" Binding="{Binding CertificateNumber}" Width="Auto" MinWidth="130" FontWeight="SemiBold" ElementStyle="{DynamicResource CenterAlignmentStyle}"/>
                        
                        <DataGridTemplateColumn Header="الجهة المرسلة" Width="4.5*" MinWidth="380">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Sender}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Padding="5,2"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
 
                        <DataGridTextColumn Header="عدد العينات" Binding="{Binding SampleCount}" Width="100" ElementStyle="{DynamicResource CenterAlignmentStyle}"/>
                        
                        <DataGridTextColumn Header="المورد" Binding="{Binding Supplier}" Width="1.5*" MinWidth="180" ElementStyle="{DynamicResource CenterAlignmentStyle}"/>
 
                        <DataGridTextColumn Header="رقم الاخطار" Binding="{Binding NotificationNumber}" Width="150" ElementStyle="{DynamicResource CenterAlignmentStyle}"/>
                        <DataGridTextColumn Header="رقم الإيصال" Binding="{Binding FinancialReceiptNumber}" Width="Auto" MinWidth="120" ElementStyle="{DynamicResource CenterAlignmentStyle}"/>
                        <DataGridTextColumn Header="تاريخ الإصدار" Binding="{Binding IssueDate, StringFormat=yyyy/MM/dd HH:mm}" Width="140" ElementStyle="{DynamicResource CenterAlignmentStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Unified Totals & Pagination Footer Bar -->
            <Border Grid.Row="3" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="20" Margin="0,20,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Pagination -->
                        <ColumnDefinition Width="Auto"/> <!-- Actions -->
                        <ColumnDefinition Width="*"/>    <!-- Spacer -->
                        <ColumnDefinition Width="Auto"/> <!-- Totals -->
                    </Grid.ColumnDefinitions>
                    
                    <!-- Pagination (Left) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <Button Command="{Binding PreviousPageCommand}" Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32">
                            <materialDesign:PackIcon Kind="ChevronLeft" />
                        </Button>
                        <TextBlock VerticalAlignment="Center" Margin="10,0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}">
                            <Run Text="صفحة " />
                            <Run Text="{Binding CurrentPage, Mode=OneWay}" />
                            <Run Text=" / " />
                            <Run Text="{Binding TotalPages, Mode=OneWay}" />
                        </TextBlock>
                        <Button Command="{Binding NextPageCommand}" Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32">
                            <materialDesign:PackIcon Kind="ChevronRight" />
                        </Button>
                    </StackPanel>

                    <!-- Action Buttons (Middle-Left) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="👁️ عرض تفاصيل الشهادة" 
                                Style="{StaticResource ActionButtonStyle}"
                                Height="35" FontSize="13"
                                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Command="{Binding ViewCertificateCommand}" Margin="0,0,10,0"/> 
                        <Button Content="✏️ تعديل" 
                                Style="{StaticResource ActionButtonStyle}"
                                Height="35" FontSize="13"
                                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Command="{Binding EditCertificateCommand}"
                                Margin="0,0,10,0"/>
                        <Button Content="📄 PDF" 
                                Style="{StaticResource ActionButtonStyle}"
                                Height="35" FontSize="13"
                                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Command="{Binding GeneratePdfCommand}" Margin="0,0,10,0"/>
                        <Button Content="🖨️ طباعة" 
                                Style="{StaticResource ActionButtonStyle}"
                                Height="35" FontSize="13"
                                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Command="{Binding PrintCertificateCommand}"/>
                    </StackPanel>

                    <!-- Totals (Right) -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,30,0">
                            <TextBlock Text="إجمالي الشهادات :" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalRecords}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,30,0">
                            <TextBlock Text="استهلاكية :" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalConsumableCertificates}" FontSize="16" FontWeight="Bold" Foreground="#3b82f6" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="بيئية :" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalEnvironmentalCertificates}" FontSize="16" FontWeight="Bold" Foreground="#10b981" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- نافذة التعديل (تظهر فوق القائمة) -->
        <Grid Panel.ZIndex="100">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <local:CertificateFormView />
        </Grid>

        <!-- نافذة تفاصيل الشهادة (Overlay) - تغطي كامل المحتوى -->
        <Grid Visibility="{Binding IsViewingDetails, Converter={StaticResource BoolToVisConverter}}" 
              Panel.ZIndex="9999"
              Grid.Row="0" Grid.RowSpan="4">
            <Grid.Background>
                <SolidColorBrush Color="Black" Opacity="0.85"/>
            </Grid.Background>
            
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="16" Margin="40"
                    MaxHeight="750" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.2"/>
                </Border.Effect>
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="*"/>    <!-- Content -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Padding="25" BorderThickness="0,0,0,1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedCertificate.CertificateType}" Value="عينات بيئية">
                                        <Setter Property="Background" Value="#E8F5E9"/>
                                        <Setter Property="BorderBrush" Value="#2E7D32"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedCertificate.CertificateType}" Value="عينات استهلاكية">
                                        <Setter Property="Background" Value="#FFF3E0"/>
                                        <Setter Property="BorderBrush" Value="#EF6C00"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding SelectedCertificate.CertificateType, StringFormat=شهادة \{0\}}" 
                                           FontSize="26" FontWeight="ExtraBold" Foreground="{DynamicResource PrimaryActionBrush}" Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileDocumentOutline" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="رقم الشهادة: " Foreground="#475569" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedCertificate.CertificateNumber}" FontWeight="Bold" Foreground="#0F172A" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                            
                             <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Command="{Binding CloseDetailsCommand}" 
                                        Style="{DynamicResource DangerButtonStyle}" 
                                        Content="✕ إغلاق"
                                        Padding="15,8" Height="36" FontSize="13" FontWeight="SemiBold"/>
                             </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Content -->
                    <ScrollViewer Grid.Row="1" Padding="25">
                        <StackPanel>
                            <!-- Row 1: Basic & Logistics -->
                            <UniformGrid Columns="2" Margin="0,0,0,20">
                                <!-- Card 1: البيانات الأساسية -->
                                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="20" Margin="0,0,10,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                            <materialDesign:PackIcon Kind="InformationOutline" Foreground="{DynamicResource PrimaryActionBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="البيانات الأساسية" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            
                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,15">
                                                <TextBlock Text="الجهة المرسلة" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,3"/>
                                                <TextBlock Text="{Binding SelectedCertificate.Sender}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,15">
                                                <TextBlock Text="المورد" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,3"/>
                                                <TextBlock Text="{Binding SelectedCertificate.Supplier}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,15">
                                                <TextBlock Text="بلد المنشأ" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,3"/>
                                                <TextBlock Text="{Binding SelectedCertificate.Origin}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,15">
                                                <TextBlock Text="جهة الإصدار" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,3"/>
                                                <TextBlock Text="{Binding SelectedCertificate.IssuingAuthority}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,15">
                                                <TextBlock Text="تاريخ الإصدار" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,3"/>
                                                <TextBlock Text="{Binding SelectedCertificate.IssueDate, StringFormat=yyyy/MM/dd HH:mm}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,15">
                                                <TextBlock Text="عدد العينات" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,3"/>
                                                <TextBlock Text="{Binding SelectedCertificate.SampleCount}" Foreground="{DynamicResource PrimaryActionBrush}" FontSize="15" FontWeight="Bold"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,5">
                                                <TextBlock Text="نوع التحليل" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,3"/>
                                                <TextBlock Text="{Binding SelectedCertificate.AnalysisType}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Card 2: البيانات الجمركية -->
                                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="20" Margin="10,0,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                            <materialDesign:PackIcon Kind="TruckOutline" Foreground="{DynamicResource PrimaryActionBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="البيانات الجمركية" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            
                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,15">
                                                <TextBlock Text="رقم الإقرار الجمركي" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,3"/>
                                                <TextBlock Text="{Binding SelectedCertificate.DeclarationNumber}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,15">
                                                <TextBlock Text="رقم الإخطار" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,3"/>
                                                <TextBlock Text="{Binding SelectedCertificate.NotificationNumber}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,15">
                                                <TextBlock Text="رقم الإيصال المالي" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,3"/>
                                                <TextBlock Text="{Binding SelectedCertificate.FinancialReceiptNumber}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,15">
                                                <TextBlock Text="رقم البوليصة" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,3"/>
                                                <TextBlock Text="{Binding SelectedCertificate.PolicyNumber}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Row 2: المعتمدين -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <materialDesign:PackIcon Kind="AccountCheck" Foreground="{DynamicResource PrimaryActionBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="المعتمدين والمسؤولين" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </StackPanel>
                                    <UniformGrid Columns="3">
                                        <StackPanel Margin="0,0,15,0">
                                            <TextBlock Text="الأخصائي" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding SelectedCertificate.SpecialistName}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,15,0">
                                            <TextBlock Text="رئيس القسم" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding SelectedCertificate.SectionHeadName}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="المدير" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding SelectedCertificate.ManagerName}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: ملاحظات -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedCertificate.Notes}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedCertificate.Notes}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <materialDesign:PackIcon Kind="NoteTextOutline" Foreground="{DynamicResource PrimaryActionBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="ملاحظات" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedCertificate.Notes}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" TextWrapping="Wrap" LineHeight="22"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 4: سجل المراجعة والوقت -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <materialDesign:PackIcon Kind="History" Foreground="{DynamicResource PrimaryActionBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="سجل المراجعة والوقت" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </StackPanel>
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,15,0">
                                            <TextBlock Text="مسؤول إصدار الشهادة" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding SelectedCertificate.CreatedByName}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding SelectedCertificate.CreatedAt, StringFormat=yyyy/MM/dd HH:mm}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,2,0,0"/>
