                                    <DataGridTextColumn Header="تاريخ القياس" Binding="{Binding MeasurementDate, StringFormat=yyyy/MM/dd}" Width="110" ElementStyle="{DynamicResource CenterAlignmentStyle}"/>
                                    <DataGridTextColumn Header="K-40" Binding="{Binding IsotopeK40}" Width="110" ElementStyle="{DynamicResource CenterAlignmentStyle}"/>
                                    <DataGridTextColumn Header="Ra-226" Binding="{Binding IsotopeRa226}" Width="110" ElementStyle="{DynamicResource CenterAlignmentStyle}"/>
                                    <DataGridTextColumn Header="Th-232" Binding="{Binding IsotopeTh232}" Width="110" ElementStyle="{DynamicResource CenterAlignmentStyle}"/>
                                    <DataGridTextColumn Header="Raeq" Binding="{Binding IsotopeRa}" Width="100" ElementStyle="{DynamicResource CenterAlignmentStyle}"/>
                                    <DataGridTextColumn Header="Cs-137" Binding="{Binding IsotopeCs137}" Width="110" ElementStyle="{DynamicResource CenterAlignmentStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>


                            <!-- Consumable/Other Table -->
                            <DataGrid ItemsSource="{Binding Samples}" AutoGenerateColumns="False" IsReadOnly="True"
                                      BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                      Background="{DynamicResource SurfaceBrush}"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                      FontSize="12" RowHeight="38" MaxHeight="350"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Style>
                                    <Style TargetType="DataGrid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelectedCertificateEnvironmental}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Style>
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                        <Setter Property="Padding" Value="8,5"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.CellStyle>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#0A000000"/> 
                                            </Trigger>
                                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                <Setter Property="Background" Value="{DynamicResource DataGridAltRowBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="14,12"/>
                                        <Setter Property="Background" Value="{DynamicResource DataGridHeaderBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="م" Binding="{Binding Root}" Width="58" ElementStyle="{DynamicResource CenterAlignmentStyle}"/>
                                    <DataGridTextColumn Header="رقم العينة" Binding="{Binding SampleNumber}" Width="173" FontWeight="Bold" ElementStyle="{DynamicResource CenterAlignmentStyle}"/>
                                    <DataGridTextColumn Header="وصف العينة" Binding="{Binding Description}" Width="2*" ElementStyle="{DynamicResource CenterAlignmentStyle}"/>
                                    <DataGridTextColumn Header="تاريخ القياس" Binding="{Binding MeasurementDate, StringFormat=yyyy/MM/dd}" Width="110" ElementStyle="{DynamicResource CenterAlignmentStyle}"/>
                                    <DataGridTextColumn Header="النتيجة" Binding="{Binding Result}" Width="*" ElementStyle="{DynamicResource CenterAlignmentStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Action History Section -->
                            <TextBlock Text="تاريخ العمليات على الشهادة" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="20,40,0,15"/>
                            <DataGrid ItemsSource="{Binding SelectedCertificateHistory}" AutoGenerateColumns="False" IsReadOnly="True"
                                      BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                      Background="{DynamicResource SurfaceBrush}"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                      FontSize="12" MaxHeight="300"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                        <Setter Property="Padding" Value="8,5"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="Background" Value="{DynamicResource DataGridHeaderBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                    </Style>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#0A000000"/> 
