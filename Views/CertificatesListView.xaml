                                             <TextBlock Text="{Binding SelectedCertificate.UpdatedAt, StringFormat=yyyy/MM/dd HH:mm}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,2,0,0"/>
