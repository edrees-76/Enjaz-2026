                                                        <DataTrigger Binding="{Binding SelectedCertificate.UpdatedAt}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                             <TextBlock Text="آخر تعديل" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,3"/>
