<Window x:Class="Enjaz.Views.ReceptionSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="البحث عن نموذج استلام" 
        Height="650" Width="1100" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        FlowDirection="RightToLeft"
        FontFamily="Inter"
        Icon="/Assets/enjaz_3d_icon_transparent.png"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="SearchCenterStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SearchRightStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Search Bar -->
            <RowDefinition Height="*"/>     <!-- Results -->
            <RowDefinition Height="Auto"/>  <!-- Status + Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🔍 البحث عن نموذج استلام العينات" FontSize="22" FontWeight="Bold" 
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock Text="اختر معيار البحث وأدخل القيمة لجلب بيانات الاستلام" FontSize="13" 
                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Search Bar -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" 
                Padding="20" Margin="0,0,0,15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <!-- Search Field Selector -->
                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="معيار البحث" FontSize="12" FontWeight="SemiBold" 
                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,5"/>
                    <ComboBox SelectedItem="{Binding SearchField, UpdateSourceTrigger=PropertyChanged}" 
                              ItemsSource="{Binding SearchFields}"
                              Style="{StaticResource FormComboBoxStyle}" 
                              Width="180" Height="40"/>
                </StackPanel>

                <!-- Search Value -->
                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="قيمة البحث" FontSize="12" FontWeight="SemiBold" 
                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding SearchValue, UpdateSourceTrigger=PropertyChanged}" 
                             materialDesign:HintAssist.Hint="أدخل قيمة البحث..."
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             Width="300" Height="40" VerticalContentAlignment="Center"
                             x:Name="SearchValueBox">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>

                <!-- Search Button -->
                <Button Command="{Binding SearchCommand}" 
                        Style="{StaticResource PrimaryButtonStyle}" 
                        Height="40" Padding="25,0" VerticalAlignment="Bottom" Foreground="White">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="White"/>
                        <TextBlock Text="بحث" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="White"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Results DataGrid -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <DataGrid ItemsSource="{Binding SearchResults}" 
                      SelectedItem="{Binding SelectedResult}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      MinRowHeight="50" RowHeight="50"
                      Background="Transparent"
                      BorderThickness="0"
                      GridLinesVisibility="None">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="15,10"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0A000000"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ت" Binding="{Binding Sequence}" Width="60" 
                                        ElementStyle="{StaticResource SearchCenterStyle}"/>
                    <DataGridTextColumn Header="رقم التحليل" Binding="{Binding AnalysisRequestNumber}" Width="110" 
                                        ElementStyle="{StaticResource SearchCenterStyle}"/>
                    <DataGridTextColumn Header="الجهة المرسلة" Binding="{Binding Sender}" Width="280"
                                        ElementStyle="{StaticResource SearchRightStyle}">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="المورد" Binding="{Binding Supplier}" Width="180"
                                        ElementStyle="{StaticResource SearchRightStyle}">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="رقم الإخطار" Binding="{Binding NotificationNumber}" Width="110" 
                                        ElementStyle="{StaticResource SearchCenterStyle}"/>
                    <DataGridTextColumn Header="النوع" Binding="{Binding CertificateType}" Width="110" 
                                        ElementStyle="{StaticResource SearchCenterStyle}"/>
                    <DataGridTextColumn Header="عدد العينات" Binding="{Binding SampleCount}" Width="90" 
                                        ElementStyle="{StaticResource SearchCenterStyle}" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="150" 
                                        ElementStyle="{StaticResource SearchCenterStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer: Status + Buttons -->
        <Border Grid.Row="3" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" 
                Padding="20,12" Margin="0,15,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Text -->
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="13" 
                           Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="✅ اختيار" Click="SelectButton_Click" 
                            Style="{StaticResource SuccessButtonStyle}" 
                            Height="40" Padding="25,0" FontSize="14" FontWeight="Bold"/>
                    <Button Content="إلغاء" Click="CancelButton_Click" 
                            Style="{StaticResource DangerButtonStyle}" 
                            Height="40" Padding="20,0" FontSize="14" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
