<UserControl x:Class="Enjaz.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:controls="clr-namespace:Enjaz.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/MainUIResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
                        <!-- اختيار نوع التقرير (تبويبات علوية) -->
                        <TabControl Background="Transparent">
                            
                            <!-- التقرير العام -->
                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📊 تقرير عام" VerticalAlignment="Center" FontSize="16" Margin="0,0,8,0" Padding="16,12"/>
                                    </StackPanel>
                                </TabItem.Header>
                                
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- Header -->
                                        <RowDefinition Height="*"/>    <!-- Content -->
                                    </Grid.RowDefinitions>

                                <!-- Main Content Card -->
                                <Border Grid.Row="1" Style="{DynamicResource DashboardCardStyle}" Padding="25">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>  <!-- Step Indicator -->
                                            <RowDefinition Height="*"/>     <!-- Step Content -->
                                            <RowDefinition Height="Auto"/>  <!-- Navigation Buttons -->
                                        </Grid.RowDefinitions>

                                        <!-- Step Indicator -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,25">
                                            <!-- Step 1 -->
                                            <Border CornerRadius="20" Padding="15,8" Margin="5,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CurrentStep}" Value="1"><Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding CurrentStep}" Value="2"><Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding CurrentStep}" Value="3"><Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding CurrentStep}" Value="4"><Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="1. تحديد النطاق" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CurrentStep}" Value="1"><Setter Property="Foreground" Value="White"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding CurrentStep}" Value="2"><Setter Property="Foreground" Value="White"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding CurrentStep}" Value="3"><Setter Property="Foreground" Value="White"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding CurrentStep}" Value="4"><Setter Property="Foreground" Value="White"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <!-- Step 2 -->
                                            <Border CornerRadius="20" Padding="15,8" Margin="5,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CurrentStep}" Value="2"><Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding CurrentStep}" Value="3"><Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding CurrentStep}" Value="4"><Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="2. تخصيص المحتوى" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CurrentStep}" Value="2"><Setter Property="Foreground" Value="White"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding CurrentStep}" Value="3"><Setter Property="Foreground" Value="White"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding CurrentStep}" Value="4"><Setter Property="Foreground" Value="White"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <!-- Step 3 -->
                                            <Border CornerRadius="20" Padding="15,8" Margin="5,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CurrentStep}" Value="3"><Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding CurrentStep}" Value="4"><Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="3. معاينة" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CurrentStep}" Value="3"><Setter Property="Foreground" Value="White"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding CurrentStep}" Value="4"><Setter Property="Foreground" Value="White"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <!-- Step 4 -->
                                            <Border CornerRadius="20" Padding="15,8" Margin="5,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CurrentStep}" Value="4"><Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="4. التصدير" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CurrentStep}" Value="4"><Setter Property="Foreground" Value="White"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>

                                        <!-- Step Content -->
                                        <Grid Grid.Row="1">
                                            <!-- Step 1: Scope Selection -->
                                            <StackPanel>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <TextBlock Text="📅 حدد الفترة الزمنية للتقرير" FontSize="20" FontWeight="Bold" 
                                                         Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,20"/>
                                                
                                                <Grid Margin="0,0,0,20">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="من تاريخ" FontSize="12" Margin="0,0,0,5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                        <controls:CustomDatePicker SelectedDate="{Binding StartDate}" />
                                                    </StackPanel>
                                                    
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="إلى تاريخ" FontSize="12" Margin="0,0,0,5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                        <controls:CustomDatePicker SelectedDate="{Binding EndDate}" />
                                                    </StackPanel>
                                                    
                                                    <Button Grid.Column="4" 
                                                            Command="{Binding LoadDataCommand}"
                                                            Style="{DynamicResource PrimaryButtonStyle}" Height="45" Padding="25,0">
                                                        <TextBlock Text="📥 تحميل البيانات" Foreground="White" FontWeight="SemiBold"/>
                                                    </Button>
                                                </Grid>

                                                <!-- Summary Cards (after loading) -->
                                                <UniformGrid Columns="6" Margin="0,20,0,0">
                                                    <UniformGrid.Style>
                                                        <Style TargetType="UniformGrid">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDataLoaded}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </UniformGrid.Style>
                                                    
                                                    <Border Style="{DynamicResource StatCardStyle}" Margin="5">
                                                        <StackPanel>
                                                            <TextBlock Text="إجمالي الشهادات" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                            <TextBlock Text="{Binding Summary.TotalCertificates}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryActionBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{DynamicResource StatCardStyle}" Margin="5">
                                                        <StackPanel>
                                                            <TextBlock Text="شهادات بيئية" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                            <TextBlock Text="{Binding Summary.EnvironmentalCertificates}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource SecondaryButtonBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{DynamicResource StatCardStyle}" Margin="5">
                                                        <StackPanel>
                                                            <TextBlock Text="شهادات استهلاكية" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                            <TextBlock Text="{Binding Summary.ConsumableCertificates}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Style="{DynamicResource StatCardStyle}" Margin="5">
                                                        <StackPanel>
                                                            <TextBlock Text="إجمالي العينات" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                            <TextBlock Text="{Binding Summary.TotalSamples}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{DynamicResource StatCardStyle}" Margin="5">
                                                        <StackPanel>
                                                            <TextBlock Text="عينات بيئية" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                            <TextBlock Text="{Binding Summary.EnvironmentalSamples}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource SecondaryButtonBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{DynamicResource StatCardStyle}" Margin="5">
                                                        <StackPanel>
                                                            <TextBlock Text="عينات استهلاكية" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                            <TextBlock Text="{Binding Summary.ConsumableSamples}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </UniformGrid>
                                            </StackPanel>

                                            <!-- Step 2: Column Selection -->
                                            <StackPanel>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <TextBlock Text="✅ اختر الأعمدة المراد عرضها في التقرير" FontSize="20" FontWeight="Bold" 
                                                         Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,20"/>
                                                
                                                <ItemsControl ItemsSource="{Binding AvailableColumns}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" 
                                                                     Margin="0,0,25,15" FontSize="14"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!-- Step 3: Preview (Charts) -->
                                            <StackPanel>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <TextBlock Text="📊 معاينة الرسوم البيانية" FontSize="20" FontWeight="Bold" 
                                                         Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,20"/>
                                                
                                                <!-- زر فتح اللوحة التفاعلية (على شكل أيقونة كبيرة) -->
                                                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="40" Margin="0,20,0,0">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        
                                                        <!-- الزر الرئيسي: أيقونة كبيرة -->
                                                        <Button Command="{Binding OpenDashboardCommand}"
                                                                Style="{x:Null}"
                                                                Width="140" Height="140"
                                                                Cursor="Hand"
                                                                Margin="0,0,0,25"
                                                                ToolTip="اضغط هنا لفتح اللوحة التفاعلية">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Grid>
                                                                        <Border x:Name="ButtonBorder" Background="{DynamicResource PrimaryBrush}" CornerRadius="25">
                                                                        <Border.Effect>
                                                                            <DropShadowEffect Color="#40000000" BlurRadius="15" ShadowDepth="5" Direction="270"/>
                                                                        </Border.Effect>
                                                                        </Border>
                                                                        <materialDesign:PackIcon Kind="Poll" Width="80" Height="80" Foreground="White" 
                                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource PrimaryActionBrush}"/>
                                                                            <Setter TargetName="ButtonBorder" Property="Effect">
                                                                                <Setter.Value>
                                                                                    <DropShadowEffect Color="#60000000" BlurRadius="20" ShadowDepth="8" Direction="270"/>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </Trigger>
                                                                        <Trigger Property="IsPressed" Value="True">
                                                                            <Setter TargetName="ButtonBorder" Property="RenderTransform">
                                                                                <Setter.Value>
                                                                                    <ScaleTransform ScaleX="0.95" ScaleY="0.95" CenterX="70" CenterY="70"/>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>

                                                        <TextBlock Text="المعاينة المتطورة للبيانات" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                                        <TextBlock Text="تم تجهيز الرسوم البيانية. اضغط على الرمز أعلاه لفتح اللوحة." FontSize="16" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                                                        
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <!-- Step 4: Export -->
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <TextBlock Text="📤 اختر صيغة التصدير" FontSize="20" FontWeight="Bold" 
                                                         Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,30" HorizontalAlignment="Center"/>
                                                
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Command="{Binding ExportPdfCommand}"
                                                            Style="{DynamicResource PrimaryButtonStyle}" Width="200" Height="60" Margin="0,0,20,0">
                                                        <TextBlock Text="📄 تصدير PDF" FontSize="16" Foreground="White" FontWeight="SemiBold"/>
                                                    </Button>
                                                    <Button Command="{Binding ExportExcelCommand}"
                                                            Style="{DynamicResource SuccessButtonStyle}" Width="200" Height="60">
                                                        <TextBlock Text="📊 تصدير Excel" FontSize="16" Foreground="White" FontWeight="SemiBold"/>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Navigation Buttons -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,25,0,0">
                                            <Button Command="{Binding PreviousStepCommand}"
                                                    Style="{DynamicResource SecondaryButtonStyle}" Width="120" Height="40" Margin="0,0,15,0">
                                                <TextBlock Text="◀ السابق" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                                            </Button>
                                            <Button Command="{Binding NextStepCommand}"
                                                    Style="{DynamicResource PrimaryButtonStyle}" Width="120" Height="40">
                                                <TextBlock Text="التالي ▶" Foreground="White" FontWeight="SemiBold"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                            </TabItem>

                            <!-- محتوى تقرير الجهات المرسلة -->
                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🏢 تقرير الجهات المرسلة" VerticalAlignment="Center" FontSize="16" Margin="0,0,8,0" Padding="16,12"/>
                                    </StackPanel>
                                </TabItem.Header>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- Header -->
                                        <RowDefinition Height="*"/>    <!-- Content -->
                                    </Grid.RowDefinitions>


                                <!-- Main Content Card -->
                                <Border Grid.Row="1" Style="{DynamicResource DashboardCardStyle}" Padding="25">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>  <!-- Step Indicator -->
                                            <RowDefinition Height="*"/>     <!-- Step Content -->
                                            <RowDefinition Height="Auto"/>  <!-- Navigation Buttons -->
                                        </Grid.RowDefinitions>

                                        <!-- Step Indicator -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,25">
                                            <!-- Step 1 -->
                                            <Border CornerRadius="20" Padding="15,8" Margin="5,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SenderReportCurrentStep}" Value="1"><Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SenderReportCurrentStep}" Value="2"><Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SenderReportCurrentStep}" Value="3"><Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="1. تحديد النطاق والجهة" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SenderReportCurrentStep}" Value="1"><Setter Property="Foreground" Value="White"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding SenderReportCurrentStep}" Value="2"><Setter Property="Foreground" Value="White"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding SenderReportCurrentStep}" Value="3"><Setter Property="Foreground" Value="White"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <!-- Step 2 -->
                                            <Border CornerRadius="20" Padding="15,8" Margin="5,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SenderReportCurrentStep}" Value="2"><Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SenderReportCurrentStep}" Value="3"><Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="2. تخصيص الأعمدة" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SenderReportCurrentStep}" Value="2"><Setter Property="Foreground" Value="White"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding SenderReportCurrentStep}" Value="3"><Setter Property="Foreground" Value="White"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <!-- Step 3 -->
                                            <Border CornerRadius="20" Padding="15,8" Margin="5,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SenderReportCurrentStep}" Value="3"><Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="3. جلب التقرير" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SenderReportCurrentStep}" Value="3"><Setter Property="Foreground" Value="White"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>

                                        <!-- Step Content -->
                                        <Grid Grid.Row="1">
                                            <!-- Step 1: Scope Selection & Sender -->
                                            <StackPanel>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SenderReportCurrentStep}" Value="1">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <TextBlock Text="🏢 حدد الجهة المرسلة والفترة الزمنية" FontSize="20" FontWeight="Bold" 
                                                         Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,20"/>
                                                
                                                <Grid Margin="0,0,0,20">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="20"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <StackPanel Grid.Row="0" Grid.ColumnSpan="3">
                                                        <TextBlock Text="الجهة المرسلة" FontSize="12" Margin="0,0,0,5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                        <ComboBox ItemsSource="{Binding SendersList}" 
                                                                  SelectedItem="{Binding SelectedSenderReportSender}"
                                                                  Style="{DynamicResource FormComboBoxStyle}"
                                                                  materialDesign:HintAssist.Hint="اختر الجهة المرسلة..."
                                                                  IsEditable="True"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                                        <TextBlock Text="من تاريخ" FontSize="12" Margin="0,0,0,5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                        <controls:CustomDatePicker SelectedDate="{Binding SenderReportStartDate}" />
                                                    </StackPanel>
                                                    
                                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                                        <TextBlock Text="إلى تاريخ" FontSize="12" Margin="0,0,0,5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                        <controls:CustomDatePicker SelectedDate="{Binding SenderReportEndDate}" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>

                                            <!-- Step 2: Column Selection -->
                                            <StackPanel>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SenderReportCurrentStep}" Value="2">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <TextBlock Text="✅ اختر الأعمدة المراد عرضها في تقرير الجهة" FontSize="20" FontWeight="Bold" 
                                                         Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,20"/>
                                                
                                                <ItemsControl ItemsSource="{Binding SenderReportAvailableColumns}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" 
                                                                     Margin="0,0,25,15" FontSize="14"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!-- Step 3: Generation & Preview -->
                                            <Grid>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SenderReportCurrentStep}" Value="3">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/> <!-- Summary -->
                                                    <RowDefinition Height="*"/>    <!-- Table -->
                                                    <RowDefinition Height="Auto"/> <!-- Export Buttons -->
                                                </Grid.RowDefinitions>

                                                <!-- Summary Cards -->
                                                <UniformGrid Grid.Row="0" Columns="6" Margin="0,0,0,20">
                                                     <Border Style="{DynamicResource StatCardStyle}" Margin="5">
                                                        <StackPanel>
                                                            <TextBlock Text="إجمالي الشهادات" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                            <TextBlock Text="{Binding SenderReportSummary.TotalCertificates}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryActionBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{DynamicResource StatCardStyle}" Margin="5">
                                                        <StackPanel>
                                                            <TextBlock Text="شهادات بيئية" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                            <TextBlock Text="{Binding SenderReportSummary.EnvironmentalCertificates}" FontSize="24" FontWeight="Bold"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{DynamicResource StatCardStyle}" Margin="5">
                                                        <StackPanel>
                                                            <TextBlock Text="شهادات استهلاكية" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                            <TextBlock Text="{Binding SenderReportSummary.ConsumableCertificates}" FontSize="24" FontWeight="Bold"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{DynamicResource StatCardStyle}" Margin="5">
                                                        <StackPanel>
                                                            <TextBlock Text="إجمالي العينات" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                            <TextBlock Text="{Binding SenderReportSummary.TotalSamples}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{DynamicResource StatCardStyle}" Margin="5">
                                                        <StackPanel>
                                                            <TextBlock Text="عينات بيئية" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                            <TextBlock Text="{Binding SenderReportSummary.EnvironmentalSamples}" FontSize="24" FontWeight="Bold"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{DynamicResource StatCardStyle}" Margin="5">
                                                        <StackPanel>
                                                            <TextBlock Text="عينات استهلاكية" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                            <TextBlock Text="{Binding SenderReportSummary.ConsumableSamples}" FontSize="24" FontWeight="Bold"/>
                                                        </StackPanel>
                                                    </Border>
                                                </UniformGrid>

                                                <!-- Results Table Hidden in UI per user request, but data remains in ViewModel for export -->

                                                <!-- Export Buttons -->
                                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                                                    <Button Command="{Binding ExportSenderReportPdfCommand}"
                                                            Style="{DynamicResource PrimaryButtonStyle}" Margin="0,0,10,0">
                                                        <TextBlock Text="📄 تصدير PDF" Foreground="White" FontWeight="SemiBold"/>
                                                    </Button>
                                                    <Button Command="{Binding ExportSenderReportExcelCommand}"
                                                            Style="{DynamicResource SuccessButtonStyle}">
                                                        <TextBlock Text="📊 تصدير Excel" Foreground="White" FontWeight="SemiBold"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>

                                        <!-- Navigation Buttons -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,25,0,0">
                                            <Button Command="{Binding SenderReportPreviousStepCommand}"
                                                    Style="{DynamicResource SecondaryButtonStyle}" Width="120" Height="40" Margin="0,0,15,0">
                                                <TextBlock Text="◀ السابق" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                                            </Button>
                                            <Button Command="{Binding SenderReportNextStepCommand}"
                                                    Style="{DynamicResource PrimaryButtonStyle}" Width="120" Height="40">
                                                <TextBlock Text="التالي ▶" Foreground="White" FontWeight="SemiBold"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                            </TabItem>
                        </TabControl>
    </Grid>
</UserControl>


