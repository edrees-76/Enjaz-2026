<UserControl x:Class="Enjaz.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             d:DesignHeight="700" d:DesignWidth="1000"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/MainUIResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>

    <!-- Dashboard Content -->
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,18,0">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Cards Header -->
                <RowDefinition Height="Auto"/> <!-- Cards Grid -->
                <RowDefinition Height="Auto"/> <!-- Main Content (Charts + Side Actions) -->
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="ملخص الأداء" FontFamily="Manrope" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                
                <!-- Year Selector Time Machine -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <materialDesign:PackIcon Kind="CalendarClock" Width="20" Height="20" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="سنة التقرير:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="14" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding AvailableYears}" SelectedItem="{Binding SelectedYear}" Width="120" Style="{DynamicResource FormComboBoxStyle}" FontSize="16" FontFamily="Manrope" FontWeight="Bold" Foreground="{DynamicResource PrimaryActionBrush}"/>
                </StackPanel>
            </Grid>

            <!-- KPI Cards 6 items -->
            <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,25">
                <!-- 1: Total Certificates -->
                <Border Style="{DynamicResource StatCardStyle}" Margin="0,0,10,0">
                    <Grid>
                        <StackPanel>
                            <materialDesign:PackIcon Kind="FileDocument" Width="28" Height="28" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Right" Margin="0,0,0,5"/>
                            <TextBlock Text="إجمالي الشهادات" FontFamily="Inter" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding TotalCertificatesCount}" FontSize="24" FontWeight="Black" FontFamily="Manrope" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2: Consumer Certificates -->
                <Border Style="{DynamicResource StatCardStyle}" Margin="0,0,10,0">
                    <Grid>
                        <StackPanel>
                            <materialDesign:PackIcon Kind="FoodApple" Width="28" Height="28" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Right" Margin="0,0,0,5"/>
                            <TextBlock Text="شهادات عينات استهلاكية" FontFamily="Inter" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding ConsumerCertificatesCount}" FontSize="24" FontWeight="Black" FontFamily="Manrope" Foreground="{DynamicResource DangerBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3: Environmental Certificates -->
                <Border Style="{DynamicResource StatCardStyle}" Margin="0,0,10,0">
                    <Grid>
                        <StackPanel>
                            <materialDesign:PackIcon Kind="Nature" Width="28" Height="28" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right" Margin="0,0,0,5"/>
                            <TextBlock Text="شهادات عينات بيئية" FontFamily="Inter" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding EnvironmentalCertificatesCount}" FontSize="24" FontWeight="Black" FontFamily="Manrope" Foreground="{DynamicResource SuccessBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 4: Total Samples -->
                <Border Style="{DynamicResource StatCardStyle}" Margin="0,0,10,0">
                    <Grid>
                        <StackPanel>
                            <materialDesign:PackIcon Kind="FlaskEmpty" Width="28" Height="28" Foreground="{DynamicResource PrimaryActionBrush}" HorizontalAlignment="Right" Margin="0,0,0,5"/>
                            <TextBlock Text="إجمالي العينات" FontFamily="Inter" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding TotalSamplesCount}" FontSize="24" FontWeight="Black" FontFamily="Manrope" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 5: Consumer Samples -->
                <Border Style="{DynamicResource StatCardStyle}" Margin="0,0,10,0">
                    <Grid>
                        <StackPanel>
                            <materialDesign:PackIcon Kind="FoodApple" Width="28" Height="28" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Right" Margin="0,0,0,5"/>
                            <TextBlock Text="شهادات عينات استهلاكية" FontFamily="Inter" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding ConsumableSamplesCount}" FontSize="24" FontWeight="Black" FontFamily="Manrope" Foreground="{DynamicResource WarningBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 6: Environmental Samples -->
                <Border Style="{DynamicResource StatCardStyle}" Margin="0,0,0,0">
                    <Grid>
                        <StackPanel>
                            <materialDesign:PackIcon Kind="Nature" Width="28" Height="28" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right" Margin="0,0,0,5"/>
                            <TextBlock Text="شهادات عينات بيئية" FontFamily="Inter" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding EnvironmentalSamplesCount}" FontSize="24" FontWeight="Black" FontFamily="Manrope" Foreground="{DynamicResource SuccessBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- Charts and Side Panel -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Charts -->
                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <!-- Charts Row 1: Certificates -->
                    <Grid Margin="0,0,0,15" Height="300">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{DynamicResource DashboardCardStyle}" Margin="0,0,10,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="إحصائيات الشهادات الشهرية" FontFamily="Manrope" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <lvc:CartesianChart Series="{Binding DashboardMonthlySeries}" LegendLocation="None">
                                    <lvc:CartesianChart.DataTooltip>
                                        <lvc:DefaultTooltip Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BulletSize="10"/>
                                    </lvc:CartesianChart.DataTooltip>
                                    <lvc:CartesianChart.AxisX>
                                        <lvc:Axis Labels="{Binding MonthlyLabels}" Foreground="{DynamicResource SecondaryTextBrush}">
                                            <lvc:Axis.Separator>
                                                <lvc:Separator Step="1" StrokeThickness="0"/>
                                            </lvc:Axis.Separator>
                                        </lvc:Axis>
                                    </lvc:CartesianChart.AxisX>
                                    <lvc:CartesianChart.AxisY>
                                        <lvc:Axis MinValue="0" LabelFormatter="{Binding YFormatter}" Foreground="{DynamicResource SecondaryTextBrush}">
                                            <lvc:Axis.Separator>
                                                <lvc:Separator StrokeThickness="1" Stroke="{DynamicResource BorderBrush}" StrokeDashArray="2"/>
                                            </lvc:Axis.Separator>
                                        </lvc:Axis>
                                    </lvc:CartesianChart.AxisY>
                                </lvc:CartesianChart>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{DynamicResource DashboardCardStyle}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="توزيع شهادات العينات (بيئي/استهلاكية)" FontFamily="Manrope" FontSize="15" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
                                <lvc:PieChart Series="{Binding TypeSeries}" LegendLocation="Bottom" HoverPushOut="5" InnerRadius="60">
                                    <lvc:PieChart.DataTooltip>
                                        <lvc:DefaultTooltip Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BulletSize="10"/>
                                    </lvc:PieChart.DataTooltip>
                                </lvc:PieChart>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Charts Row 2: Samples -->
                    <Grid Height="300">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{DynamicResource DashboardCardStyle}" Margin="0,0,10,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="إحصائيات العينات الشهرية" FontFamily="Manrope" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <lvc:CartesianChart Series="{Binding SampleMonthlySeries}" LegendLocation="None">
                                    <lvc:CartesianChart.DataTooltip>
                                        <lvc:DefaultTooltip Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BulletSize="10"/>
                                    </lvc:CartesianChart.DataTooltip>
                                    <lvc:CartesianChart.AxisX>
                                        <lvc:Axis Labels="{Binding MonthlyLabels}" Foreground="{DynamicResource SecondaryTextBrush}">
                                            <lvc:Axis.Separator>
                                                <lvc:Separator Step="1" StrokeThickness="0"/>
                                            </lvc:Axis.Separator>
                                        </lvc:Axis>
                                    </lvc:CartesianChart.AxisX>
                                    <lvc:CartesianChart.AxisY>
                                        <lvc:Axis MinValue="0" LabelFormatter="{Binding YFormatter}" Foreground="{DynamicResource SecondaryTextBrush}">
                                            <lvc:Axis.Separator>
                                                <lvc:Separator StrokeThickness="1" Stroke="{DynamicResource BorderBrush}" StrokeDashArray="2"/>
                                            </lvc:Axis.Separator>
                                        </lvc:Axis>
                                    </lvc:CartesianChart.AxisY>
                                </lvc:CartesianChart>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{DynamicResource DashboardCardStyle}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="توزيع شهادات العينات (بيئي/استهلاكية)" FontFamily="Manrope" FontSize="15" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
                                <lvc:PieChart Series="{Binding SampleTypeSeries}" LegendLocation="Bottom" HoverPushOut="5" InnerRadius="60">
                                    <lvc:PieChart.DataTooltip>
                                        <lvc:DefaultTooltip Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BulletSize="10"/>
                                    </lvc:PieChart.DataTooltip>
                                </lvc:PieChart>
                            </DockPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Right: Quick Actions + Recent Activities -->
                <StackPanel Grid.Column="1">
                    <!-- Quick Actions Base -->
                    <Border Style="{DynamicResource DashboardCardStyle}" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="إجراءات سريعة" FontFamily="Manrope" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <UniformGrid Columns="2" Rows="2">
                                <Button Command="{Binding DataContext.CertificatesVM.AddCertificateCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                        Style="{DynamicResource ActionButtonStyle}"
                                        Height="80" Margin="0,0,10,10" 
                                        Background="{DynamicResource GlassSurfaceBrush}" 
                                        BorderBrush="{DynamicResource GlassBorderBrush}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="FilePlus" Width="28" Height="28" Foreground="{DynamicResource PrimaryActionBrush}" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                        <TextBlock Text="شهادة جديدة" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding DataContext.ShowSampleReceptionsCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                        Style="{DynamicResource ActionButtonStyle}"
                                        Height="80" Margin="0,0,0,10" 
                                        Background="{DynamicResource GlassSurfaceBrush}" 
                                        BorderBrush="{DynamicResource GlassBorderBrush}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="FlaskPlus" Width="28" Height="28" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                        <TextBlock Text="استلام عينات" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding DataContext.ShowCertificatesCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                        Style="{DynamicResource ActionButtonStyle}"
                                        Height="80" Margin="0,0,10,0" 
                                        Background="{DynamicResource GlassSurfaceBrush}" 
                                        BorderBrush="{DynamicResource GlassBorderBrush}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="FileSearch" Width="28" Height="28" Foreground="{DynamicResource SecondaryButtonBrush}" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                        <TextBlock Text="بحث السجلات" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding DataContext.ShowAdminProceduresCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                        Style="{DynamicResource ActionButtonStyle}"
                                        Height="80" Margin="0,0,0,0" 
                                        Background="{DynamicResource GlassSurfaceBrush}" 
                                        BorderBrush="{DynamicResource GlassBorderBrush}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="FileDocumentEdit" Width="28" Height="28" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                        <TextBlock Text="إجراء إداري" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Recent Activities List -->
                    <Border Style="{DynamicResource DashboardCardStyle}" VerticalAlignment="Stretch" MinHeight="450" Visibility="{Binding ShowRecentActivities, Converter={StaticResource BoolToVisConverter}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="أحدث الأنشطة" FontFamily="Manrope" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            
                            <ListBox ItemsSource="{Binding RecentActivities}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource GlassSurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="12,12" Margin="0,0,0,8" CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource PrimaryBrush}" Opacity="0.1" Grid.Column="0" Margin="0,0,15,0"/>
                                                <materialDesign:PackIcon Kind="History" Width="24" Height="24" Foreground="{DynamicResource PrimaryBrush}" Grid.Column="0" Margin="0,0,15,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <!-- Action Title -->
                                                    <TextBlock Text="{Binding Action}" FontFamily="Manrope" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                                    
                                                    <!-- Detailed Description -->
                                                    <TextBlock Text="{Binding Description}" FontFamily="Inter" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                                    
                                                    <!-- User and Time Info -->
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="AccountOutline" Width="14" Height="14" Foreground="{DynamicResource PrimaryActionBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding UserName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                                        
                                                        <materialDesign:PackIcon Kind="ClockOutline" Width="14" Height="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding TimeFormatted}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
    </Grid>
</UserControl>


