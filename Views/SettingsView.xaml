<UserControl x:Class="Enjaz.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/MainUIResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>

                    <TabControl Margin="10,0,25,20">
                        <!-- Tab 1: General Settings -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="SettingsOutline" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="إعدادات عامة" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="15">
                                    <TextBlock Text="⚙️ إعدادات عامة" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryActionBrush}" Margin="0,0,0,15"/>
                                    <Border Style="{DynamicResource DashboardCardStyle}" Margin="0,0,0,25" Padding="25">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="تفعيل جرس التنبيهات" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <TextBlock Text="عرض أيقونة الجرس عند وجود شهادات منتهية الصلاحية أو عينات غير طبيعية" 
                                                               FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5,0,0"/>
                                                </StackPanel>
                                                
                                                <ToggleButton Grid.Column="1" IsChecked="{Binding EnableAlerts}" Style="{DynamicResource MaterialDesignSwitchToggleButton}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    
                                    <Button Command="{Binding SaveSettingsCommand}" 
                                            Content="حفظ التغييرات" 
                                            Style="{DynamicResource ActionButtonStyle}" 
                                            Background="{DynamicResource SuccessBrush}" 
                                            HorizontalAlignment="Left" Width="200"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Tab 2: Data & Backup -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="DatabaseOutline" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="إدارة البيانات" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="15">
                                    <TextBlock Text="💾 إدارة البيانات والنسخ" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryActionBrush}" Margin="0,0,0,15"/>
                                    <Border Style="{DynamicResource DashboardCardStyle}" Margin="0,0,0,25" Padding="25">
                                        <StackPanel>
                                            <TextBlock Text="مسار قاعدة البيانات (للربط عبر الشبكة)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryActionBrush}" Margin="0,0,0,10"/>
                                            <Grid Margin="0,0,0,15">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding DatabasePath}" 
                                                         materialDesign:HintAssist.Hint="اتركه فارغاً للاستخدام الافتراضي المحلي"
                                                         Style="{DynamicResource FormTextBoxStyle}" IsReadOnly="True" Margin="0,0,10,0"/>
                                                <Button Grid.Column="1" Command="{Binding BrowseDatabaseFolderCommand}" 
                                                        Style="{DynamicResource MaterialDesignRaisedButton}" 
                                                        Background="{DynamicResource SecondaryButtonBrush}" 
                                                        Foreground="White" Width="45" Height="45" Padding="0"
                                                        materialDesign:ButtonAssist.CornerRadius="10">
                                                    <materialDesign:PackIcon Kind="DatabaseSearch" Width="24" Height="24"/>
                                                </Button>
                                            </Grid>

                                            <TextBlock Text="مسار النسخ الاحتياطي" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10"/>
                                            <Grid Margin="0,0,0,15">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding BackupPath}" Style="{DynamicResource FormTextBoxStyle}" IsReadOnly="True" Margin="0,0,10,0"/>
                                                <Button Grid.Column="1" Command="{Binding BrowseFolderCommand}" 
                                                        Style="{DynamicResource MaterialDesignRaisedButton}" 
                                                        Background="{DynamicResource SecondaryButtonBrush}" 
                                                        Foreground="White" Width="45" Height="45" Padding="0"
                                                        materialDesign:ButtonAssist.CornerRadius="10">
                                                    <materialDesign:PackIcon Kind="FolderOpen" Width="24" Height="24"/>
                                                </Button>
                                            </Grid>

                                            <TextBlock Text="مسار النسخ الاحتياطي السحابي (Google Drive / OneDrive) ☁️" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10"/>
                                            <Grid Margin="0,0,0,25">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding CloudSyncPath}" 
                                                         materialDesign:HintAssist.Hint="اتركه فارغاً لتعطيل الميزة"
                                                         Style="{DynamicResource FormTextBoxStyle}" IsReadOnly="True" Margin="0,0,10,0"/>
                                                <Button Grid.Column="1" Command="{Binding BrowseCloudFolderCommand}" 
                                                        Style="{DynamicResource MaterialDesignRaisedButton}" 
                                                        Background="{DynamicResource SecondaryButtonBrush}" 
                                                        Foreground="White" Width="45" Height="45" Padding="0"
                                                        materialDesign:ButtonAssist.CornerRadius="10">
                                                    <materialDesign:PackIcon Kind="CloudUpload" Width="24" Height="24"/>
                                                </Button>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Auto Backup Toggle -->
                                                <StackPanel Grid.Column="0" Margin="0,0,40,0">
                                                    <TextBlock Text="نسخ تلقائي" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10"/>
                                                    <ToggleButton IsChecked="{Binding AutoBackupEnabled}" Style="{DynamicResource MaterialDesignSwitchToggleButton}"/>
                                                </StackPanel>

                                                <!-- Frequency Radio Buttons -->
                                                <StackPanel Grid.Column="1" Visibility="{Binding AutoBackupEnabled, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock Text="تكرار النسخ" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton Content="يومي" IsChecked="{Binding IsDaily}" Margin="0,0,20,0" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                        <RadioButton Content="أسبوعي" IsChecked="{Binding IsWeekly}" Margin="0,0,20,0" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                        <RadioButton Content="شهري" IsChecked="{Binding IsMonthly}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>

                                            <Separator Background="{DynamicResource BorderBrush}" Margin="0,25" Opacity="0.5"/>

                                            <!-- Atqaan Upgrade Section -->
                                            <TextBlock Text="🚀 ترقية من منظومة اتقان القديمة" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryActionBrush}" Margin="0,0,0,10"/>
                                            <TextBlock Text="استخدم هذا الخيار لترقية قاعدة بيانات قديمة من منظومة اتقان. سيتم جلب كافة الشهادات وإنشاء سجلات استلام لها تلقائياً بترميز ذكي." 
                                                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,15" TextWrapping="Wrap"/>
                                            
                                            <Button Command="{Binding UpgradeAtqaanDbCommand}" 
                                                    Style="{DynamicResource ActionButtonStyle}" 
                                                    Background="{DynamicResource SecondaryButtonBrush}" 
                                                    Foreground="White"
                                                    HorizontalAlignment="Left" Padding="20,0" Height="50" Width="300">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="DatabaseRefresh" Margin="0,0,10,0" VerticalAlignment="Center" Width="24" Height="24"/>
                                                    <TextBlock Text="بدء ترقية نسخة اتقان" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>

                                            <Separator Background="{DynamicResource BorderBrush}" Margin="0,25" Opacity="0.5"/>

                                            <!-- Action Buttons -->
                                            <UniformGrid Columns="3">
                                                <Button Command="{Binding SaveSettingsCommand}" 
                                                        Style="{DynamicResource ActionButtonStyle}" 
                                                        Background="{DynamicResource SuccessBrush}" 
                                                        Foreground="White"
                                                        Margin="0,0,10,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="ContentSave" Margin="0,0,10,0" VerticalAlignment="Center" Width="22" Height="22"/>
                                                        <TextBlock Text="حفظ الإعدادات" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Command="{Binding ManualBackupCommand}" 
                                                        Style="{DynamicResource ActionButtonStyle}" 
                                                        Background="{DynamicResource SecondaryButtonBrush}" 
                                                        Foreground="White"
                                                        Margin="0,0,10,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="BackupRestore" Margin="0,0,10,0" VerticalAlignment="Center" Width="22" Height="22"/>
                                                        <TextBlock Text="نسخ احتياطي الآن" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Command="{Binding RestoreBackupCommand}" 
                                                        Style="{DynamicResource ActionButtonStyle}" 
                                                        Background="{DynamicResource TertiaryButtonBrush}" 
                                                        Foreground="White">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="DatabaseImport" Margin="0,0,10,0" VerticalAlignment="Center" Width="22" Height="22"/>
                                                        <TextBlock Text="استعادة نسخة" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{DynamicResource DashboardCardStyle}" Margin="0,0,0,25" Padding="25">
                                        <StackPanel>
                                            <TextBlock Text="أرشفة السجلات القديمة" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryActionBrush}" Margin="0,0,0,10"/>
                                            <TextBlock Text="نقل سجلات النشاط القديمة إلى أرشيف منفصل لتحسين الأداء" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,15"/>
                                            
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <TextBlock Text="الاحتفاظ بـ:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <ComboBox Grid.Column="1" SelectedValue="{Binding ArchiveMonths}" SelectedValuePath="Tag" Style="{DynamicResource FormComboBoxStyle}" Width="200" HorizontalAlignment="Left" Margin="0,0,10,0">
                                                    <ComboBoxItem Content="3 أشهر" Tag="3"/>
                                                    <ComboBoxItem Content="6 أشهر (مستحسن)" Tag="6"/>
                                                    <ComboBoxItem Content="سنة واحدة" Tag="12"/>
                                                    <ComboBoxItem Content="سنتين" Tag="24"/>
                                                </ComboBox>
                                                
                                                <Button Grid.Column="2" 
                                                        Style="{DynamicResource ActionButtonStyle}"
                                                        Background="{DynamicResource SecondaryButtonBrush}"
                                                        Foreground="White"
                                                        Command="{Binding ArchiveLogsCommand}" 
                                                        Padding="20,0" Height="45">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="ArchiveArrowDown" Margin="0,0,8,0" VerticalAlignment="Center" Width="18" Height="18"/>
                                                        <TextBlock Text="بدء الأرشفة الآن" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Tab 3: Admin & Security -->
                        <TabItem Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisConverter}}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ShieldLockOutline" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="الأمان والإدارة" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="15">
                                    <TextBlock Text="🛡️ الإدارة والأمان" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,15"/>
                                    <Border Style="{DynamicResource DashboardCardStyle}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" Padding="25">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="إعادة ضبط البرنامج" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,5"/>
                                                <TextBlock Text="تحذير: هذا الإجراء سيؤدي لمسح كافة بيانات المنظومة بشكل نهائي." FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" MaxWidth="500"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Command="{Binding FactoryResetCommand}" 
                                                        Style="{DynamicResource DangerButtonStyle}" 
                                                        Padding="20,0" Height="50" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="AlertDecagram" Margin="0,0,10,0" VerticalAlignment="Center" Width="22" Height="22"/>
                                                        <TextBlock Text="بدء إعادة الضبط" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
    </Grid>
</UserControl>



