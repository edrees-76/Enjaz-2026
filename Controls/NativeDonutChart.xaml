<UserControl x:Class="Enjaz.Controls.NativeDonutChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="400">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" MinWidth="150" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Canvas x:Name="DonutCanvas" Width="160" Height="160" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <!-- Center text -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="CenterValueText" 
                           FontSize="20" FontWeight="Black" FontFamily="Manrope"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock x:Name="CenterLabelText" 
                           FontSize="10" FontFamily="Tahoma"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Legend (عناوين توضيحية) -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="10,0,0,0" FlowDirection="RightToLeft">
            <ItemsControl ItemsSource="{Binding Slices, RelativeSource={RelativeSource AncestorType=UserControl}}" VerticalAlignment="Center">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,6">
                            <Ellipse Width="14" Height="14" Fill="{Binding Fill}" Margin="0,0,0,0" VerticalAlignment="Center" />
                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Label}" 
                                           Foreground="{DynamicResource PrimaryTextBrush}" 
                                           FontFamily="Tahoma" FontSize="13" 
                                           TextWrapping="Wrap" MaxWidth="200" 
                                           ToolTip="{Binding Label}" />
                                <TextBlock Text="{Binding Percentage, StringFormat={}{0:F1}%}" 
                                           Foreground="{DynamicResource SecondaryTextBrush}" 
                                           FontFamily="Manrope" FontSize="11" FontWeight="SemiBold"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
