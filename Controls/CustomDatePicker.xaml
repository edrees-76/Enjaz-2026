<UserControl x:Class="Enjaz.Controls.CustomDatePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid>
        <!-- حقل الإدخال (يستخدم ألوان الثيم الرئيسية - آمن في الشجرة المرئية الرئيسية) -->
        <Border x:Name="InputBorder"
                Background="{DynamicResource InputBackgroundBrush}"
                BorderBrush="{DynamicResource InputBorderBrush}"
                BorderThickness="1" CornerRadius="4" Height="45"
                Cursor="Hand" PreviewMouseLeftButtonDown="ToggleCalendar_Click">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="DisplayText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="{DynamicResource FontSizeNormal}"/>

                <materialDesign:PackIcon Kind="Calendar" Grid.Column="1"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource SecondaryTextBrush}"
                                         Width="20" Height="20"/>
            </Grid>
        </Border>

        <!-- نافذة التقويم المنبثقة -->
        <Popup x:Name="CalendarPopup"
               StaysOpen="True"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=InputBorder}"
               AllowsTransparency="True"
               PopupAnimation="Fade">

            <Border x:Name="PopupBorder"
                    Width="300"
                    CornerRadius="8"
                    Margin="5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.3"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- شريط العنوان -->
                    <Border x:Name="HeaderBorder" Grid.Row="0"
                            Padding="16" CornerRadius="8,8,0,0">
                        <StackPanel>
                            <TextBlock x:Name="YearText" FontSize="14" Opacity="0.8" Cursor="Hand" PreviewMouseLeftButtonDown="YearText_Click"/>
                            <TextBlock x:Name="FullDateText" FontSize="22" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- تنقل الشهور -->
                    <Grid Grid.Row="1" Margin="10,10,10,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="PrevMonthBtn" Grid.Column="0"
                                Click="PrevMonth_Click" Cursor="Hand"
                                Width="30" Height="30">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" CornerRadius="15">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <materialDesign:PackIcon Kind="ChevronLeft" Width="20" Height="20"/>
                        </Button>

                        <TextBlock x:Name="MonthYearText" Grid.Column="1"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="15" FontWeight="SemiBold"/>

                        <Button x:Name="NextMonthBtn" Grid.Column="2"
                                Click="NextMonth_Click" Cursor="Hand"
                                Width="30" Height="30">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" CornerRadius="15">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <materialDesign:PackIcon Kind="ChevronRight" Width="20" Height="20"/>
                        </Button>
                    </Grid>

                    <!-- أسماء الأيام -->
                    <UniformGrid x:Name="DayNamesGrid" Grid.Row="2" Columns="7" Margin="10,0,10,5"/>

                    <!-- شبكة الأيام -->
                    <UniformGrid x:Name="DaysGrid" Grid.Row="3" Columns="7" Rows="6" Margin="10,0,10,10"/>

                    <!-- منتقي السنة (Year Picker) -->
                    <Grid x:Name="YearPickerPanel" Grid.Row="1" Grid.RowSpan="3" 
                          Background="{Binding Background, ElementName=PopupBorder}"
                          Visibility="Collapsed">
                        <ScrollViewer x:Name="YearScrollViewer" VerticalScrollBarVisibility="Auto">
                            <UniformGrid x:Name="YearsGrid" Columns="4" Margin="10"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- أزرار الإجراءات -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="10,0,10,10">
                        <Button x:Name="CancelBtn"
                                Click="CancelBtn_Click" Cursor="Hand">
                            <TextBlock Text="إلغاء" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontWeight="SemiBold" FontSize="14" />
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" CornerRadius="5" Padding="12,6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="OkBtn"
                                Click="OkBtn_Click" Cursor="Hand" Margin="5,0,0,0">
                            <TextBlock Text="موافق" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontWeight="SemiBold" FontSize="14" />
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="OkBtnBorder" Background="{TemplateBinding Background}"
                                            CornerRadius="5" Padding="16,6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
