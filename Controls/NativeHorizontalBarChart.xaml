<UserControl x:Class="Enjaz.Controls.NativeHorizontalBarChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="400"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <local:WidthPercentageConverter x:Key="WidthConverter" xmlns:local="clr-namespace:Enjaz.Controls"/>
    </UserControl.Resources>

    <ItemsControl x:Name="BarsItemsControl" Margin="10">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Grid Margin="0,4" Height="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>

                    <!-- Label -->
                    <TextBlock Grid.Column="0" Text="{Binding Label}" 
                               VerticalAlignment="Center" 
                               FontFamily="Tahoma" FontSize="12"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Label}"
                               ToolTipService.InitialShowDelay="100"/>

                    <!-- Bar -->
                    <Border Grid.Column="1" 
                            VerticalAlignment="Center" 
                            Height="22" 
                            HorizontalAlignment="Right"
                            CornerRadius="4"
                            Background="{DynamicResource CardBackgroundBrush}"
                            Margin="8,0">
                        <Border HorizontalAlignment="Right"
                                CornerRadius="4"
                                Background="{Binding Fill}"
                                Cursor="Hand"
                                ToolTipService.InitialShowDelay="100"
                                ToolTipService.BetweenShowDelay="0">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource WidthConverter}">
                                    <Binding Path="WidthPercentage"/>
                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Border, AncestorLevel=2}"/>
                                </MultiBinding>
                            </Border.Width>
                            <Border.ToolTip>
                                <ToolTip HasDropShadow="True" Placement="Mouse">
                                    <Border Background="#E60F172A" CornerRadius="8" Padding="12,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" FontFamily="Tahoma" FontSize="13" 
                                                       FontWeight="Bold" Foreground="White" 
                                                       FlowDirection="RightToLeft" Margin="0,0,0,4"/>
                                            <TextBlock FontFamily="Tahoma" FontSize="14" Foreground="#4ECDC4" 
                                                       FlowDirection="RightToLeft">
                                                <Run Text="العدد: "/><Run Text="{Binding Value, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </ToolTip>
                            </Border.ToolTip>
                        </Border>
                    </Border>

                    <!-- Value -->
                    <TextBlock Grid.Column="2" Text="{Binding Value}" 
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               FontFamily="Tahoma" FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
