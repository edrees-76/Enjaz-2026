<UserControl x:Class="Enjaz.Controls.NativeSingleBarChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Enjaz.Controls"
             mc:Ignorable="d" d:DesignHeight="280" d:DesignWidth="500"
             FlowDirection="LeftToRight">

    <UserControl.Resources>
        <local:SingleBarHeightConverter x:Key="SingleBarHeightConverter"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Max Value Label -->
        <TextBlock x:Name="MaxValueLabel" Grid.Row="0" 
                   FontFamily="Tahoma" FontSize="10" 
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   HorizontalAlignment="Left" Margin="0,0,0,4"/>

        <!-- Bars Area -->
        <ItemsControl x:Name="BarsItemsControl" Grid.Row="1">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Value Label -->
                        <TextBlock Grid.Row="0" Text="{Binding Value}" 
                                   HorizontalAlignment="Center"
                                   FontFamily="Tahoma" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,4"/>

                        <!-- Bar -->
                        <Border Grid.Row="1" 
                                VerticalAlignment="Bottom"
                                CornerRadius="4,4,0,0"
                                Background="{Binding Fill}"
                                Cursor="Hand"
                                ToolTipService.InitialShowDelay="100"
                                ToolTipService.BetweenShowDelay="0"
                                MinHeight="4">
                            <Border.Height>
                                <MultiBinding Converter="{StaticResource SingleBarHeightConverter}">
                                    <Binding Path="HeightPercentage"/>
                                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource AncestorType=Grid}"/>
                                </MultiBinding>
                            </Border.Height>
                            <Border.ToolTip>
                                <ToolTip HasDropShadow="True" Placement="Mouse">
                                    <Border Background="#E60F172A" CornerRadius="8" Padding="12,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" FontFamily="Tahoma" FontSize="13" 
                                                       FontWeight="Bold" Foreground="White" 
                                                       FlowDirection="RightToLeft" Margin="0,0,0,4"/>
                                            <TextBlock FontFamily="Tahoma" FontSize="14" Foreground="#4ECDC4" 
                                                       FlowDirection="RightToLeft">
                                                <Run Text="العدد: "/><Run Text="{Binding Value, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </ToolTip>
                            </Border.ToolTip>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- X-axis Labels -->
        <ItemsControl x:Name="LabelsItemsControl" Grid.Row="2" Margin="0,6,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Label}" 
                               HorizontalAlignment="Center"
                               FontFamily="Tahoma" FontSize="10"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
