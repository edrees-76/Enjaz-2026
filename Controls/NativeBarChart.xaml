<UserControl x:Class="Enjaz.Controls.NativeBarChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Enjaz.Controls"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="600">
    <UserControl.Resources>
        <controls:BarTooltipConverter x:Key="BarTooltipConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock x:Name="MaxValueLabel" 
                   Grid.Row="0"
                   HorizontalAlignment="Left" 
                   Margin="5,0,0,5"
                   FontFamily="Tahoma" 
                   Foreground="{DynamicResource SecondaryTextBrush}"/>

        <Grid Grid.Row="1" Margin="10,0,10,0" x:Name="ChartArea">
            <UniformGrid Rows="4" Columns="1">
                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"/>
                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"/>
                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"/>
                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"/>
            </UniformGrid>

            <ItemsControl x:Name="BarsItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="3,0" VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Bar 1 -->
                            <Border Grid.Column="0" 
                                    Margin="1,0"
                                    VerticalAlignment="Bottom"
                                    CornerRadius="4,4,0,0"
                                    Background="{Binding Color1}"
                                    Cursor="Hand"
                                    ToolTipService.InitialShowDelay="100"
                                    ToolTipService.BetweenShowDelay="0">
                                <Border.Height>
                                    <MultiBinding Converter="{StaticResource PercentageToHeightConverter}">
                                        <Binding Path="Height1"/>
                                        <Binding ElementName="ChartArea" Path="ActualHeight"/>
                                    </MultiBinding>
                                </Border.Height>
                                <Border.ToolTip>
                                    <ToolTip Background="Transparent" BorderThickness="0" Padding="0" HasDropShadow="True">
                                        <Border Background="#E60F172A" CornerRadius="8" Padding="14,10">
                                            <StackPanel FlowDirection="RightToLeft">
                                                <TextBlock Text="{Binding Month}" FontFamily="Tahoma" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <Ellipse Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding Label1}" FontFamily="Tahoma" FontSize="12" Foreground="#94A3B8" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding Value1}" FontFamily="Manrope" FontSize="13" FontWeight="Bold" Foreground="#10B981"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <Ellipse Width="8" Height="8" Fill="#38BDF8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding Label2}" FontFamily="Tahoma" FontSize="12" Foreground="#94A3B8" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding Value2}" FontFamily="Manrope" FontSize="13" FontWeight="Bold" Foreground="#38BDF8"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </ToolTip>
                                </Border.ToolTip>
                            </Border>

                            <!-- Bar 2 -->
                            <Border Grid.Column="1" 
                                    Margin="1,0"
                                    VerticalAlignment="Bottom"
                                    CornerRadius="4,4,0,0"
                                    Background="{Binding Color2}"
                                    Cursor="Hand"
                                    ToolTipService.InitialShowDelay="100"
                                    ToolTipService.BetweenShowDelay="0">
                                <Border.Height>
                                    <MultiBinding Converter="{StaticResource PercentageToHeightConverter}">
                                        <Binding Path="Height2"/>
                                        <Binding ElementName="ChartArea" Path="ActualHeight"/>
                                    </MultiBinding>
                                </Border.Height>
                                <Border.ToolTip>
                                    <ToolTip Background="Transparent" BorderThickness="0" Padding="0" HasDropShadow="True">
                                        <Border Background="#E60F172A" CornerRadius="8" Padding="14,10">
                                            <StackPanel FlowDirection="RightToLeft">
                                                <TextBlock Text="{Binding Month}" FontFamily="Tahoma" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <Ellipse Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding Label1}" FontFamily="Tahoma" FontSize="12" Foreground="#94A3B8" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding Value1}" FontFamily="Manrope" FontSize="13" FontWeight="Bold" Foreground="#10B981"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <Ellipse Width="8" Height="8" Fill="#38BDF8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding Label2}" FontFamily="Tahoma" FontSize="12" Foreground="#94A3B8" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding Value2}" FontFamily="Manrope" FontSize="13" FontWeight="Bold" Foreground="#38BDF8"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </ToolTip>
                                </Border.ToolTip>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- X-Axis Labels -->
        <ItemsControl x:Name="LabelsItemsControl" Grid.Row="2" Margin="10,5,10,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Month}" 
                               HorizontalAlignment="Center" 
                               FontFamily="Tahoma" 
                               FontSize="10"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
